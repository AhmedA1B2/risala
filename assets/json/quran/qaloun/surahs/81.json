[
    {
        "surah_number": 81,
        "verse_number": 1,
        "content": "إِذَا اَ۬لشَّمْسُ كُوِّرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 2,
        "content": "وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 3,
        "content": "وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 4,
        "content": "وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 5,
        "content": "وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 6,
        "content": "وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 7,
        "content": "وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 8,
        "content": "وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 9,
        "content": "بِأَيِّ ذَنۢبٖ قُتِلَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 10,
        "content": "وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 11,
        "content": "وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 12,
        "content": "وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 13,
        "content": "وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ"
    },
    {
        "surah_number": 81,
        "verse_number": 14,
        "content": "عَلِمَتْ نَفْسٞ مَّا أَحْضَرَتْۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 15,
        "content": "فَلَا أُقْسِمُ بِالْخُنَّسِ"
    },
    {
        "surah_number": 81,
        "verse_number": 16,
        "content": "اِ۬لْجَوَارِ اِ۬لْكُنَّسِ"
    },
    {
        "surah_number": 81,
        "verse_number": 17,
        "content": "وَاليْلِ إِذَا عَسْعَسَ"
    },
    {
        "surah_number": 81,
        "verse_number": 18,
        "content": "وَالصُّبْحِ إِذَا تَنَفَّسَ"
    },
    {
        "surah_number": 81,
        "verse_number": 19,
        "content": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ"
    },
    {
        "surah_number": 81,
        "verse_number": 20,
        "content": "ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ"
    },
    {
        "surah_number": 81,
        "verse_number": 21,
        "content": "مُّطَاعٖ ثَمَّ أَمِينٖۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 22,
        "content": "وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 23,
        "content": "وَلَقَدْ رَءَاهُ بِالْأُفُقِ اِ۬لْمُبِينِۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 24,
        "content": "وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 25,
        "content": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ"
    },
    {
        "surah_number": 81,
        "verse_number": 26,
        "content": "فَأَيْنَ تَذْهَبُونَۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 27,
        "content": "إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ"
    },
    {
        "surah_number": 81,
        "verse_number": 28,
        "content": "لِمَن شَآءَ مِنكُمْ أَنْ يَّسْتَقِيمَۖ"
    },
    {
        "surah_number": 81,
        "verse_number": 29,
        "content": "وَمَا تَشَآءُونَ إِلَّا أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ"
    }
]