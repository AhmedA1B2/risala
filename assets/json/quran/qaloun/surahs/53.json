[
    {
        "surah_number": 53,
        "verse_number": 1,
        "content": "وَالنَّجْمِ إِذَا هَوَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 2,
        "content": "مَا ضَلَّ صَٰحِبُكُمْ وَمَا غَوَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 3,
        "content": "وَمَا يَنطِقُ عَنِ اِ۬لْهَوَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 4,
        "content": "إِنْ هُوَ إِلَّا وَحْيٞ يُوحَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 5,
        "content": "عَلَّمَهُۥ شَدِيدُ اُ۬لْقُوَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 6,
        "content": "ذُو مِرَّةٖۖ فَاسْتَوَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 7,
        "content": "وَهْوَ بِالْأُفُقِ اِ۬لْأَعْلَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 8,
        "content": "ثُمَّ دَنَا فَتَدَلَّىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 9,
        "content": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 10,
        "content": "فَأَوْحَىٰ إِلَىٰ عَبْدِهِۦ مَا أَوْحَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 11,
        "content": "مَا كَذَبَ اَ۬لْفُؤَادُ مَا رَأَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 12,
        "content": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 13,
        "content": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 14,
        "content": "عِندَ سِدْرَةِ اِ۬لْمُنتَهَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 15,
        "content": "عِندَهَا جَنَّةُ اُ۬لْمَأْوَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 16,
        "content": "إِذْ يَغْشَى اَ۬لسِّدْرَةَ مَا يَغْشَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 17,
        "content": "مَا زَاغَ اَ۬لْبَصَرُ وَمَا طَغَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 18,
        "content": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ اِ۬لْكُبْرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 19,
        "content": "أَفَرَٰ۬يْتُمُ اُ۬للَّٰتَ وَالْعُزَّىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 20,
        "content": "وَمَنَوٰةَ اَ۬لثَّالِثَةَ اَ۬لْأُخْرَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 21,
        "content": "أَلَكُمُ اُ۬لذَّكَرُ وَلَهُ اُ۬لْأُنثَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 22,
        "content": "تِلْكَ إِذاٗ قِسْمَةٞ ضِيزَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 23,
        "content": "إِنْ هِيَ إِلَّا أَسْمَآءٞ سَمَّيْتُمُوهَا أَنتُمْ وَءَابَآؤُكُم مَّا أَنزَلَ اَ۬للَّهُ بِهَا مِن سُلْطَٰنٍۖ إِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّ وَمَا تَهْوَى اَ۬لْأَنفُسُۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ اُ۬لْهُدَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 24,
        "content": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 25,
        "content": "فَلِلهِ اِ۬لْأٓخِرَةُ وَالْأُولَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 26,
        "content": "۞ وَكَم مِّن مَّلَكٖ فِے اِ۬لسَّمَٰوَٰتِ لَا تُغْنِے شَفَٰعَتُهُمْ شَئْاً إِلَّا مِنۢ بَعْدِ أَنْ يَّأْذَنَ اَ۬للَّهُ لِمَنْ يَّشَآءُ وَيَرْضَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 27,
        "content": "إِنَّ اَ۬لذِينَ لَا يُؤْمِنُونَ بِالْأٓخِرَةِ لَيُسَمُّونَ اَ۬لْمَلَٰٓئِكَةَ تَسْمِيَةَ اَ۬لْأُنثَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 28,
        "content": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍۖ إِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّۖ وَإِنَّ اَ۬لظَّنَّ لَا يُغْنِے مِنَ اَ۬لْحَقِّ شَئْاٗۖ فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَاۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 29,
        "content": "ذَٰلِكَ مَبْلَغُهُم مِّنَ اَ۬لْعِلْمِۖ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهْوَ أَعْلَمُ بِمَنِ اِ۪هْتَدَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 30,
        "content": "وَلِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لْأَرْضِ لِيَجْزِيَ اَ۬لذِينَ أَسَٰٓـُٔواْ بِمَا عَمِلُواْ وَيَجْزِيَ اَ۬لذِينَ أَحْسَنُواْ بِالْحُسْنَىۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 31,
        "content": "اَ۬لذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ اَ۬لْإِثْمِ وَالْفَوَٰحِشَ إِلَّا اَ۬للَّمَمَۖ إِنَّ رَبَّكَ وَٰسِعُ اُ۬لْمَغْفِرَةِۖ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ اَ۬لْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٞ فِے بُطُونِ أُمَّهَٰتِكُمْۖ فَلَا تُزَكُّواْ أَنفُسَكُمْۖ هُوَ أَعْلَمُ بِمَنِ اِ۪تَّقَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 32,
        "content": "أَفَرَٰ۬يْتَ اَ۬لذِے تَوَلَّىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 33,
        "content": "وَأَعْطَىٰ قَلِيلاٗ وَأَكْدَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 34,
        "content": "أَعِندَهُۥ عِلْمُ اُ۬لْغَيْبِ فَهْوَ يَرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 35,
        "content": "أَمْ لَمْ يُنَبَّأْ بِمَا فِے صُحُفِ مُوسَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 36,
        "content": "وَإِبْرَٰهِيمَ اَ۬لذِے وَفَّىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 37,
        "content": "أَلَّا تَزِرُ وَازِرَةٞ وِزْرَ أُخْرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 38,
        "content": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 39,
        "content": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 40,
        "content": "ثُمَّ يُجْزَيٰهُ اُ۬لْجَزَآءَ اَ۬لْأَوْفَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 41,
        "content": "وَأَنَّ إِلَىٰ رَبِّكَ اَ۬لْمُنتَهَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 42,
        "content": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 43,
        "content": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَاۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 44,
        "content": "وَأَنَّهُۥ خَلَقَ اَ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالْأُنثَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 45,
        "content": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 46,
        "content": "وَأَنَّ عَلَيْهِ اِ۬لنَّشْأَةَ اَ۬لْأُخْرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 47,
        "content": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 48,
        "content": "وَأَنَّهُۥ هُوَ رَبُّ اُ۬لشِّعْرَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 49,
        "content": "وَأَنَّهُۥ أَهْلَكَ عَاداٗ اَ۬لُّاؤْلَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 50,
        "content": "وَثَمُوداٗ فَمَا أَبْقَىٰ"
    },
    {
        "surah_number": 53,
        "verse_number": 51,
        "content": "وَقَوْمَ نُوحٖ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ هُمْ أَظْلَمَ وَأَطْغَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 52,
        "content": "وَالْمُؤْتَفِكَةَ أَهْوَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 53,
        "content": "فَغَشَّيٰهَا مَا غَشَّىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 54,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 55,
        "content": "۞ هَٰذَا نَذِيرٞ مِّنَ اَ۬لنُّذُرِ اِ۬لْأُولَىٰۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 56,
        "content": "أَزِفَتِ اِ۬لْأٓزِفَةُۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 57,
        "content": "لَيْسَ لَهَا مِن دُونِ اِ۬للَّهِ كَاشِفَةٌۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 58,
        "content": "أَفَمِنْ هَٰذَا اَ۬لْحَدِيثِ تَعْجَبُونَ"
    },
    {
        "surah_number": 53,
        "verse_number": 59,
        "content": "وَتَضْحَكُونَ وَلَا تَبْكُونَ"
    },
    {
        "surah_number": 53,
        "verse_number": 60,
        "content": "وَأَنتُمْ سَٰمِدُونَۖ"
    },
    {
        "surah_number": 53,
        "verse_number": 61,
        "content": "فَاسْجُدُواْ لِلهِ وَاعْبُدُواْۖ۩"
    }
]