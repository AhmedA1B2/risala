[
    {
        "surah_number": 55,
        "verse_number": 1,
        "content": "اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 2,
        "content": "خَلَقَ اَ۬لْإِنسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 3,
        "content": "اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 4,
        "content": "وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 5,
        "content": "وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ"
    },
    {
        "surah_number": 55,
        "verse_number": 6,
        "content": "أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 7,
        "content": "وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 8,
        "content": "وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 9,
        "content": "فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لْأَكْمَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 10,
        "content": "وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 11,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 12,
        "content": "خَلَقَ اَ۬لْإِنسَٰنَ مِن صَلْصَٰلٖ كَالْفَخَّارِ"
    },
    {
        "surah_number": 55,
        "verse_number": 13,
        "content": "وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نَّارٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 14,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 15,
        "content": "رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 16,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 17,
        "content": "مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ"
    },
    {
        "surah_number": 55,
        "verse_number": 18,
        "content": "بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 19,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 20,
        "content": "يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 21,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 22,
        "content": "وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالْأَعْلَٰمِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 23,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 24,
        "content": "كُلُّ مَنْ عَلَيْهَا فَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 25,
        "content": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالْإِكْرَامِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 26,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 27,
        "content": "يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالْأَرْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 28,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 29,
        "content": "سَنَفْرُغُ لَكُمْ أَيُّهَ اَ۬لثَّقَلَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 30,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 31,
        "content": "۞ يَٰمَعْشَرَ اَ۬لْجِنِّ وَالْإِنسِ إِنِ اِ۪سْتَطَعْتُمْ أَن تَنفُذُواْ مِنْ أَقْطَارِ اِ۬لسَّمَٰوَٰتِ وَالْأَرْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 32,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 33,
        "content": "يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نَّارٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 34,
        "content": "وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 35,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 36,
        "content": "فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 37,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 38,
        "content": "فَيَوْمَئِذٖ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦ إِنسٞ وَلَا جَآنّٞۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 39,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 40,
        "content": "يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِالنَّوَٰصِے وَالْأَقْدَامِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 41,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 42,
        "content": "هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ"
    },
    {
        "surah_number": 55,
        "verse_number": 43,
        "content": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 44,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 45,
        "content": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ"
    },
    {
        "surah_number": 55,
        "verse_number": 46,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 47,
        "content": "ذَوَاتَا أَفْنَانٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 48,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 49,
        "content": "فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 50,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 51,
        "content": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوْجَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 52,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 53,
        "content": "مُتَّكِـِٕينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٖ وَجَنَا اَ۬لْجَنَّتَيْنِ دَانٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 54,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 55,
        "content": "فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 56,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 57,
        "content": "كَأَنَّهُنَّ اَ۬لْيَاقُوتُ وَالْمَرْجَانُۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 58,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 59,
        "content": "هَلْ جَزَآءُ اُ۬لْإِحْسَٰنِ إِلَّا اَ۬لْإِحْسَٰنُۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 60,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 61,
        "content": "وَمِن دُونِهِمَا جَنَّتَٰنِ"
    },
    {
        "surah_number": 55,
        "verse_number": 62,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 63,
        "content": "مُدْهَآمَّتَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 64,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 65,
        "content": "فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 66,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 67,
        "content": "فِيهِمَا فَٰكِهَةٞ وَنَخْلٞ وَرُمَّانٞۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 68,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 69,
        "content": "فِيهِنَّ خَيْرَٰتٌ حِسَانٞۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 70,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 71,
        "content": "حُورٞ مَّقْصُورَٰتٞ فِے اِ۬لْخِيَامِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 72,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 73,
        "content": "لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 74,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 75,
        "content": "مُتَّكِـِٕينَ عَلَىٰ رَفْرَفٍ خُضْرٖ وَعَبْقَرِيٍّ حِسَانٖۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 76,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"
    },
    {
        "surah_number": 55,
        "verse_number": 77,
        "content": "تَبَٰرَكَ اَ۪سْمُ رَبِّكَ ذِے اِ۬لْجَلَٰلِ وَالْإِكْرَامِۖ"
    }
]