        "verse_number": 16,
        "content": "أَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ"
    },
    {
        "surah_number": 90,
        "verse_number": 17,
        "content": "ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ"
    },
    {
        "surah_number": 90,
        "verse_number": 18,
