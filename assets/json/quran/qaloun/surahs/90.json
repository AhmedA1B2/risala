        "content": "يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ"
    },
    {
        "surah_number": 90,
        "verse_number": 7,
        "content": "أَيَحْسِبُ أَن لَّمْ يَرَهُۥ أَحَدٌۖ"
    },
    {
