[
    {
        "surah_number": 37,
        "verse_number": 1,
        "content": "وَالصَّٰٓفَّٰتِ صَفّاٗ"
    },
    {
        "surah_number": 37,
        "verse_number": 2,
        "content": "فَالزَّٰجِرَٰتِ زَجْراٗ"
    },
    {
        "surah_number": 37,
        "verse_number": 3,
        "content": "فَالتَّٰلِيَٰتِ ذِكْراً"
    },
    {
        "surah_number": 37,
        "verse_number": 4,
        "content": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 5,
        "content": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 6,
        "content": "إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْيَا بِزِينَةِ اِ۬لْكَوَاكِبِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 7,
        "content": "وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 8,
        "content": "لَّا يَسْمَعُونَ إِلَى اَ۬لْمَلَإِ اِ۬لْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 9,
        "content": "دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ"
    },
    {
        "surah_number": 37,
        "verse_number": 10,
        "content": "إِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 11,
        "content": "فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقاً أَم مَّنْ خَلَقْنَاۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 12,
        "content": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 13,
        "content": "وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 14,
        "content": "وَإِذَا رَأَوْاْ ءَايَةٗ يَسْتَسْخِرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 15,
        "content": "وَقَالُواْ إِنْ هَٰذَا إِلَّا سِحْرٞ مُّبِينٌ"
    },
    {
        "surah_number": 37,
        "verse_number": 16,
        "content": "أَٰ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 17,
        "content": "أَوْءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 18,
        "content": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 19,
        "content": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 20,
        "content": "وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 21,
        "content": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 22,
        "content": "۞ اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 23,
        "content": "مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمْ إِلَىٰ صِرَٰطِ اِ۬لْجَحِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 24,
        "content": "وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 25,
        "content": "مَا لَكُمْ لَا تَنَاصَرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 26,
        "content": "بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 27,
        "content": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 28,
        "content": "قَالُواْ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ اِ۬لْيَمِينِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 29,
        "content": "قَالُواْ بَل لَّمْ تَكُونُواْ مُؤْمِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 30,
        "content": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 31,
        "content": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا إِنَّا لَذَآئِقُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 32,
        "content": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 33,
        "content": "فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 34,
        "content": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 35,
        "content": "إِنَّهُمْ كَانُواْ إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 36,
        "content": "وَيَقُولُونَ أَٰئِنَّا لَتَارِكُواْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 37,
        "content": "بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 38,
        "content": "إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لْأَلِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 39,
        "content": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 40,
        "content": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 41,
        "content": "أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ"
    },
    {
        "surah_number": 37,
        "verse_number": 42,
        "content": "فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 43,
        "content": "فِے جَنَّٰتِ اِ۬لنَّعِيمِ"
    },
    {
        "surah_number": 37,
        "verse_number": 44,
        "content": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 45,
        "content": "يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ"
    },
    {
        "surah_number": 37,
        "verse_number": 46,
        "content": "بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 47,
        "content": "لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 48,
        "content": "وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ"
    },
    {
        "surah_number": 37,
        "verse_number": 49,
        "content": "كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 50,
        "content": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 51,
        "content": "۞ قَالَ قَآئِلٞ مِّنْهُمْ إِنِّے كَانَ لِے قَرِينٞ"
    },
    {
        "surah_number": 37,
        "verse_number": 52,
        "content": "يَقُولُ أَٰ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 53,
        "content": "أَٰ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَدِينُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 54,
        "content": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 55,
        "content": "فَاطَّلَعَ فَرَءَاهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 56,
        "content": "قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ"
    },
    {
        "surah_number": 37,
        "verse_number": 57,
        "content": "وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 58,
        "content": "أَفَمَا نَحْنُ بِمَيِّتِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 59,
        "content": "إِلَّا مَوْتَتَنَا اَ۬لْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 60,
        "content": "إِنَّ هَٰذَا لَهْوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 61,
        "content": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 62,
        "content": "أَذَٰلِكَ خَيْرٞ نُّزُلاً أَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 63,
        "content": "إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 64,
        "content": "إِنَّهَا شَجَرَةٞ تَخْرُجُ فِے أَصْلِ اِ۬لْجَحِيمِ"
    },
    {
        "surah_number": 37,
        "verse_number": 65,
        "content": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 66,
        "content": "فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 67,
        "content": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 68,
        "content": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى اَ۬لْجَحِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 69,
        "content": "إِنَّهُمْ أَلْفَوْاْ ءَابَآءَهُمْ ضَآلِّينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 70,
        "content": "فَهُمْ عَلَىٰ ءَاثَٰرِهِمْ يُهْرَعُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 71,
        "content": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ اُ۬لْأَوَّلِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 72,
        "content": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 73,
        "content": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 74,
        "content": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 75,
        "content": "وَلَقَدْ نَادَيٰنَا نُوحٞۖ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 76,
        "content": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 77,
        "content": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 78,
        "content": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 79,
        "content": "سَلَٰمٌ عَلَىٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 80,
        "content": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 81,
        "content": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 82,
        "content": "ثُمَّ أَغْرَقْنَا اَ۬لْأٓخَرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 83,
        "content": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"
    },
    {
        "surah_number": 37,
        "verse_number": 84,
        "content": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ"
    },
    {
        "surah_number": 37,
        "verse_number": 85,
        "content": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 86,
        "content": "أَٰئِفْكاً ءَالِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 87,
        "content": "فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 88,
        "content": "فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ"
    },
    {
        "surah_number": 37,
        "verse_number": 89,
        "content": "فَقَالَ إِنِّے سَقِيمٞ"
    },
    {
        "surah_number": 37,
        "verse_number": 90,
        "content": "فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 91,
        "content": "فَرَاغَ إِلَىٰ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 92,
        "content": "مَا لَكُمْ لَا تَنطِقُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 93,
        "content": "فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ"
    },
    {
        "surah_number": 37,
        "verse_number": 94,
        "content": "فَأَقْبَلُواْ إِلَيْهِ يَزِفُّونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 95,
        "content": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 96,
        "content": "وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 97,
        "content": "قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ"
    },
    {
        "surah_number": 37,
        "verse_number": 98,
        "content": "فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لْأَسْفَلِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 99,
        "content": "وَقَالَ إِنِّے ذَاهِبٌ إِلَىٰ رَبِّے سَيَهْدِينِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 100,
        "content": "رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 101,
        "content": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 102,
        "content": "فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَرَىٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَرَىٰۖ قَالَ يَٰأَبَتِ اِ۪فْعَلْ مَا تُؤْمَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 103,
        "content": "فَلَمَّا أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"
    },
    {
        "surah_number": 37,
        "verse_number": 104,
        "content": "وَنَٰدَيْنَٰهُ أَنْ يَّٰإِبْرَٰهِيمُ"
    },
    {
        "surah_number": 37,
        "verse_number": 105,
        "content": "قَدْ صَدَّقْتَ اَ۬لرُّءْيَاۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 106,
        "content": "إِنَّ هَٰذَا لَهْوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 107,
        "content": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 108,
        "content": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 109,
        "content": "سَلَٰمٌ عَلَىٰ إِبْرَٰهِيمَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 110,
        "content": "كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 111,
        "content": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 112,
        "content": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 113,
        "content": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 114,
        "content": "۞ وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 115,
        "content": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 116,
        "content": "وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 117,
        "content": "وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 118,
        "content": "وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 119,
        "content": "وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 120,
        "content": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 121,
        "content": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 122,
        "content": "إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 123,
        "content": "وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 124,
        "content": "إِذْ قَالَ لِقَوْمِهِۦ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 125,
        "content": "أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 126,
        "content": "اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لْأَوَّلِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 127,
        "content": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 128,
        "content": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 129,
        "content": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 130,
        "content": "سَلَٰمٌ عَلَىٰ ءَالِ يَاسِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 131,
        "content": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 132,
        "content": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 133,
        "content": "وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 134,
        "content": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥ أَجْمَعِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 135,
        "content": "إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 136,
        "content": "ثُمَّ دَمَّرْنَا اَ۬لْأٓخَرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 137,
        "content": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 138,
        "content": "وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 139,
        "content": "وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 140,
        "content": "إِذْ أَبَقَ إِلَى اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ"
    },
    {
        "surah_number": 37,
        "verse_number": 141,
        "content": "فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 142,
        "content": "فَالْتَقَمَهُ اُ۬لْحُوتُ وَهْوَ مُلِيمٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 143,
        "content": "فَلَوْلَا أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 144,
        "content": "لَلَبِثَ فِے بَطْنِهِۦ إِلَىٰ يَوْمِ يُبْعَثُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 145,
        "content": "۞ فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهْوَ سَقِيمٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 146,
        "content": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةٗ مِّنْ يَّقْطِينٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 147,
        "content": "وَأَرْسَلْنَٰهُ إِلَىٰ مِاْئَةِ أَلْفٍ أَوْ يَزِيدُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 148,
        "content": "فَـَٔامَنُواْ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 149,
        "content": "فَاسْتَفْتِهِمْ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 150,
        "content": "أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاٗ وَهُمْ شَٰهِدُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 151,
        "content": "أَلَا إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 152,
        "content": "وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 153,
        "content": "أَصْطَفَى اَ۬لْبَنَاتِ عَلَى اَ۬لْبَنِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 154,
        "content": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 155,
        "content": "أَفَلَا تَذَّكَّرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 156,
        "content": "أَمْ لَكُمْ سُلْطَٰنٞ مُّبِينٞ"
    },
    {
        "surah_number": 37,
        "verse_number": 157,
        "content": "فَأْتُواْ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 158,
        "content": "وَجَعَلُواْ بَيْنَهُۥ وَبَيْنَ اَ۬لْجِنَّةِ نَسَباٗۖ وَلَقَدْ عَلِمَتِ اِ۬لْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 159,
        "content": "سُبْحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 160,
        "content": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 161,
        "content": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 162,
        "content": "مَا أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 163,
        "content": "إِلَّا مَنْ هُوَ صَالِ اِ۬لْجَحِيمِۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 164,
        "content": "وَمَا مِنَّا إِلَّا لَهُۥ مَقَامٞ مَّعْلُومٞۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 165,
        "content": "وَإِنَّا لَنَحْنُ اُ۬لصَّآفُّونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 166,
        "content": "وَإِنَّا لَنَحْنُ اُ۬لْمُسَبِّحُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 167,
        "content": "وَإِن كَانُواْ لَيَقُولُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 168,
        "content": "لَوْ أَنَّ عِندَنَا ذِكْراٗ مِّنَ اَ۬لْأَوَّلِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 169,
        "content": "لَكُنَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 170,
        "content": "فَكَفَرُواْ بِهِۦۖ فَسَوْفَ يَعْلَمُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 171,
        "content": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا اَ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 37,
        "verse_number": 172,
        "content": "إِنَّهُمْ لَهُمُ اُ۬لْمَنصُورُونَ"
    },
    {
        "surah_number": 37,
        "verse_number": 173,
        "content": "وَإِنَّ جُندَنَا لَهُمُ اُ۬لْغَٰلِبُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 174,
        "content": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 175,
        "content": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 176,
        "content": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 177,
        "content": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ اُ۬لْمُنذَرِينَۖ"
    },
    {
        "surah_number": 37,
        "verse_number": 178,
