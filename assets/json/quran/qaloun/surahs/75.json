[
    {
        "surah_number": 75,
        "verse_number": 1,
        "content": "لَا أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ"
    },
    {
        "surah_number": 75,
        "verse_number": 2,
        "content": "وَلَا أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 3,
        "content": "أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"
    },
    {
        "surah_number": 75,
        "verse_number": 4,
        "content": "بَلَىٰۖ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 5,
        "content": "بَلْ يُرِيدُ اُ۬لْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 6,
        "content": "يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 7,
        "content": "فَإِذَا بَرَقَ اَ۬لْبَصَرُ"
    },
    {
        "surah_number": 75,
        "verse_number": 8,
        "content": "وَخَسَفَ اَ۬لْقَمَرُ"
    },
    {
        "surah_number": 75,
        "verse_number": 9,
        "content": "وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ"
    },
    {
        "surah_number": 75,
        "verse_number": 10,
        "content": "يَقُولُ اُ۬لْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ اَ۬لْمَفَرُّۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 11,
        "content": "كَلَّا لَا وَزَرَۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 12,
        "content": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 13,
        "content": "يُنَبَّؤُاْ اُ۬لْإِنسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 14,
        "content": "بَلِ اِ۬لْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ"
    },
    {
        "surah_number": 75,
        "verse_number": 15,
        "content": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 16,
        "content": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 17,
        "content": "فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ"
    },
    {
        "surah_number": 75,
        "verse_number": 18,
        "content": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 19,
        "content": "كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ"
    },
    {
        "surah_number": 75,
        "verse_number": 20,
        "content": "وَتَذَرُونَ اَ۬لْأٓخِرَةَۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 21,
        "content": "وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ"
    },
    {
        "surah_number": 75,
        "verse_number": 22,
        "content": "إِلَىٰ رَبِّهَا نَاظِرَةٞۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 23,
        "content": "وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ"
    },
    {
        "surah_number": 75,
        "verse_number": 24,
        "content": "تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 25,
        "content": "كَلَّا إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ"
    },
    {
        "surah_number": 75,
        "verse_number": 26,
        "content": "وَقِيلَ مَن رَّاقٖ"
    },
    {
        "surah_number": 75,
        "verse_number": 27,
        "content": "وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ"
    },
    {
        "surah_number": 75,
        "verse_number": 28,
        "content": "وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ"
    },
    {
        "surah_number": 75,
        "verse_number": 29,
        "content": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 30,
        "content": "فَلَا صَدَّقَ وَلَا صَلَّىٰۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 31,
        "content": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 32,
        "content": "ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِۦ يَتَمَطَّىٰۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 33,
        "content": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"
    },
    {
        "surah_number": 75,
        "verse_number": 34,
        "content": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 35,
        "content": "أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 36,
        "content": "أَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْنَىٰ"
    },
    {
        "surah_number": 75,
        "verse_number": 37,
        "content": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ"
    },
    {
        "surah_number": 75,
        "verse_number": 38,
        "content": "فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالْأُنثَىٰۖ"
    },
    {
        "surah_number": 75,
        "verse_number": 39,
        "content": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَنْ يُّحْـِۧيَ اَ۬لْمَوْتَىٰۖ"
    }
]