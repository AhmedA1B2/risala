[
    {
        "surah_number": 89,
        "verse_number": 1,
        "content": "وَالْفَجْرِ"
    },
    {
        "surah_number": 89,
        "verse_number": 2,
        "content": "وَلَيَالٍ عَشْرٖ"
    },
    {
        "surah_number": 89,
        "verse_number": 3,
        "content": "وَالشَّفْعِ وَالْوَتْرِ"
    },
    {
        "surah_number": 89,
        "verse_number": 4,
        "content": "وَاليْلِ إِذَا يَسْرِۦ"
    },
    {
        "surah_number": 89,
        "verse_number": 5,
        "content": "هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 6,
        "content": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"
    },
    {
        "surah_number": 89,
        "verse_number": 7,
        "content": "إِرَمَ ذَاتِ اِ۬لْعِمَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 8,
        "content": "اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ"
    },
    {
        "surah_number": 89,
        "verse_number": 9,
        "content": "وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 10,
        "content": "وَفِرْعَوْنَ ذِے اِ۬لْأَوْتَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 11,
        "content": "اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ"
    },
    {
        "surah_number": 89,
        "verse_number": 12,
        "content": "فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ"
    },
    {
        "surah_number": 89,
        "verse_number": 13,
        "content": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 14,
        "content": "إِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 15,
        "content": "فَأَمَّا اَ۬لْإِنسَٰنُ إِذَا مَا اَ۪بْتَلَيٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ"
    },
    {
        "surah_number": 89,
        "verse_number": 16,
        "content": "فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 17,
        "content": "وَأَمَّا إِذَا مَا اَ۪بْتَلَيٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ"
    },
    {
        "surah_number": 89,
        "verse_number": 18,
        "content": "فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"
    },
    {
        "surah_number": 89,
        "verse_number": 19,
        "content": "كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ"
    },
    {
        "surah_number": 89,
        "verse_number": 20,
        "content": "وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ"
    },
    {
        "surah_number": 89,
        "verse_number": 21,
        "content": "وَتَأْكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ"
    },
    {
        "surah_number": 89,
        "verse_number": 22,
        "content": "وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ"
    },
    {
        "surah_number": 89,
        "verse_number": 23,
        "content": "كَلَّاۖ إِذَا دُكَّتِ اِ۬لْأَرْضُ دَكّاٗ دَكّاٗ"
    },
    {
        "surah_number": 89,
        "verse_number": 24,
        "content": "وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ"
    },
    {
        "surah_number": 89,
        "verse_number": 25,
        "content": "وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ"
    },
    {
        "surah_number": 89,
        "verse_number": 26,
        "content": "يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لْإِنسَٰنُ وَأَنَّىٰ لَهُ اُ۬لذِّكْرَىٰۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 27,
        "content": "يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 28,
        "content": "فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدٞ"
    },
    {
        "surah_number": 89,
        "verse_number": 29,
        "content": "وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدٞۖ"
    },
    {
        "surah_number": 89,
        "verse_number": 30,
        "content": "يَٰأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ"
    },
    {
        "surah_number": 89,
        "verse_number": 31,
        "content": "اُ۪رْجِعِے إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ"
    },
    {
        "surah_number": 89,
        "verse_number": 32,
        "content": "فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ"
    }
]