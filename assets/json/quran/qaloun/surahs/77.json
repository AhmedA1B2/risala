[
    {
        "surah_number": 77,
        "verse_number": 1,
        "content": "وَالْمُرْسَلَٰتِ عُرْفاٗ"
    },
    {
        "surah_number": 77,
        "verse_number": 2,
        "content": "فَالْعَٰصِفَٰتِ عَصْفاٗ"
    },
    {
        "surah_number": 77,
        "verse_number": 3,
        "content": "وَالنَّٰشِرَٰتِ نَشْراٗ"
    },
    {
        "surah_number": 77,
        "verse_number": 4,
        "content": "فَالْفَٰرِقَٰتِ فَرْقاٗ"
    },
    {
        "surah_number": 77,
        "verse_number": 5,
        "content": "فَالْمُلْقِيَٰتِ ذِكْراً"
    },
    {
        "surah_number": 77,
        "verse_number": 6,
        "content": "عُذْراً أَوْ نُذُراً"
    },
    {
        "surah_number": 77,
        "verse_number": 7,
        "content": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 8,
        "content": "فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ"
    },
    {
        "surah_number": 77,
        "verse_number": 9,
        "content": "وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ"
    },
    {
        "surah_number": 77,
        "verse_number": 10,
        "content": "وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ"
    },
    {
        "surah_number": 77,
        "verse_number": 11,
        "content": "وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ"
    },
    {
        "surah_number": 77,
        "verse_number": 12,
        "content": "لِأَيِّ يَوْمٍ أُجِّلَتْ"
    },
    {
        "surah_number": 77,
        "verse_number": 13,
        "content": "لِيَوْمِ اِ۬لْفَصْلِۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 14,
        "content": "وَمَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 15,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 16,
        "content": "۞ أَلَمْ نُهْلِكِ اِ۬لْأَوَّلِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 17,
        "content": "ثُمَّ نُتْبِعُهُمُ اُ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 18,
        "content": "كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 19,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 20,
        "content": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ"
    },
    {
        "surah_number": 77,
        "verse_number": 21,
        "content": "فَجَعَلْنَٰهُ فِے قَرَارٖ مَّكِينٍ"
    },
    {
        "surah_number": 77,
        "verse_number": 22,
        "content": "إِلَىٰ قَدَرٖ مَّعْلُومٖ"
    },
    {
        "surah_number": 77,
        "verse_number": 23,
        "content": "فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 24,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 25,
        "content": "أَلَمْ نَجْعَلِ اِ۬لْأَرْضَ كِفَاتاً"
    },
    {
        "surah_number": 77,
        "verse_number": 26,
        "content": "أَحْيَآءٗ وَأَمْوَٰتاٗ"
    },
    {
        "surah_number": 77,
        "verse_number": 27,
        "content": "وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 28,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 29,
        "content": "اَ۪نطَلِقُواْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
        "surah_number": 77,
        "verse_number": 30,
        "content": "اَ۪نطَلِقُواْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ"
    },
    {
        "surah_number": 77,
        "verse_number": 31,
        "content": "لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 32,
        "content": "إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ"
    },
    {
        "surah_number": 77,
        "verse_number": 33,
        "content": "كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 34,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 35,
        "content": "هَٰذَا يَوْمُ لَا يَنطِقُونَ"
    },
    {
        "surah_number": 77,
        "verse_number": 36,
        "content": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 37,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 38,
        "content": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالْأَوَّلِينَ"
    },
    {
        "surah_number": 77,
        "verse_number": 39,
        "content": "فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 40,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 41,
        "content": "إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ"
    },
    {
        "surah_number": 77,
        "verse_number": 42,
        "content": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 43,
        "content": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 44,
        "content": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 45,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 46,
        "content": "كُلُواْ وَتَمَتَّعُواْ قَلِيلاً إِنَّكُم مُّجْرِمُونَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 47,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 48,
        "content": "وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 49,
        "content": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"
    },
    {
        "surah_number": 77,
        "verse_number": 50,
        "content": "فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُؤْمِنُونَۖ"
    }
]