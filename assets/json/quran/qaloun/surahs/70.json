[
    {
        "surah_number": 70,
        "verse_number": 1,
        "content": "سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ"
    },
    {
        "surah_number": 70,
        "verse_number": 2,
        "content": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٞ"
    },
    {
        "surah_number": 70,
        "verse_number": 3,
        "content": "مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 4,
        "content": "تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 5,
        "content": "فَاصْبِرْ صَبْراٗ جَمِيلاًۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 6,
        "content": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ"
    },
    {
        "surah_number": 70,
        "verse_number": 7,
        "content": "وَنَرَيٰهُ قَرِيباٗۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 8,
        "content": "يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ"
    },
    {
        "surah_number": 70,
        "verse_number": 9,
        "content": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ"
    },
    {
        "surah_number": 70,
        "verse_number": 10,
        "content": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيماٗ"
    },
    {
        "surah_number": 70,
        "verse_number": 11,
        "content": "يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ"
    },
    {
        "surah_number": 70,
        "verse_number": 12,
        "content": "وَصَٰحِبَتِهِۦ وَأَخِيهِ"
    },
    {
        "surah_number": 70,
        "verse_number": 13,
        "content": "وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ"
    },
    {
        "surah_number": 70,
        "verse_number": 14,
        "content": "وَمَن فِے اِ۬لْأَرْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ"
    },
    {
        "surah_number": 70,
        "verse_number": 15,
        "content": "كَلَّاۖ إِنَّهَا لَظَىٰ"
    },
    {
        "surah_number": 70,
        "verse_number": 16,
        "content": "نَزَّاعَةٞ لِّلشَّوَىٰ"
    },
    {
        "surah_number": 70,
        "verse_number": 17,
        "content": "تَدْعُواْ مَنْ أَدْبَرَ وَتَوَلَّىٰ"
    },
    {
        "surah_number": 70,
        "verse_number": 18,
        "content": "وَجَمَعَ فَأَوْعَىٰۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 19,
        "content": "۞ إِنَّ اَ۬لْإِنسَٰنَ خُلِقَ هَلُوعاً"
    },
    {
        "surah_number": 70,
        "verse_number": 20,
        "content": "إِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ"
    },
    {
        "surah_number": 70,
        "verse_number": 21,
        "content": "وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً"
    },
    {
        "surah_number": 70,
        "verse_number": 22,
        "content": "إِلَّا اَ۬لْمُصَلِّينَ"
    },
    {
        "surah_number": 70,
        "verse_number": 23,
        "content": "اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 24,
        "content": "وَالذِينَ فِے أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ"
    },
    {
        "surah_number": 70,
        "verse_number": 25,
        "content": "لِّلسَّآئِلِ وَالْمَحْرُومِۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 26,
        "content": "وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 27,
        "content": "وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"
    },
    {
        "surah_number": 70,
        "verse_number": 28,
        "content": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٖۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 29,
        "content": "وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"
    },
    {
        "surah_number": 70,
        "verse_number": 30,
        "content": "إِلَّا عَلَىٰ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 31,
        "content": "فَمَنِ اِ۪بْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 32,
        "content": "وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 33,
        "content": "وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 34,
        "content": "وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"
    },
    {
        "surah_number": 70,
        "verse_number": 35,
        "content": "أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 36,
        "content": "فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ"
    },
    {
        "surah_number": 70,
        "verse_number": 37,
        "content": "عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 38,
        "content": "أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمْ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ"
    },
    {
        "surah_number": 70,
        "verse_number": 39,
        "content": "كَلَّاۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 40,
        "content": "۞ فَلَا أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ"
    },
    {
        "surah_number": 70,
        "verse_number": 41,
        "content": "عَلَىٰ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ"
    },
    {
        "surah_number": 70,
        "verse_number": 42,
        "content": "فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ"
    },
    {
        "surah_number": 70,
        "verse_number": 43,
        "content": "يَوْمَ يَخْرُجُونَ مِنَ اَ۬لْأَجْدَاثِ سِرَاعاٗ كَأَنَّهُمْ إِلَىٰ نَصْبٖ يُوفِضُونَ"
    },
    {
        "surah_number": 70,
        "verse_number": 44,
        "content": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ"
    }
]