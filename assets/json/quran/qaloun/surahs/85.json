[
    {
        "surah_number": 85,
        "verse_number": 1,
        "content": "وَالسَّمَآءِ ذَاتِ اِ۬لْبُرُوجِ"
    },
    {
        "surah_number": 85,
        "verse_number": 2,
        "content": "وَالْيَوْمِ اِ۬لْمَوْعُودِ"
    },
    {
        "surah_number": 85,
        "verse_number": 3,
        "content": "وَشَاهِدٖ وَمَشْهُودٖ"
    },
    {
        "surah_number": 85,
        "verse_number": 4,
        "content": "قُتِلَ أَصْحَٰبُ اُ۬لْأُخْدُودِ"
    },
    {
        "surah_number": 85,
        "verse_number": 5,
        "content": "اِ۬لنَّارِ ذَاتِ اِ۬لْوَقُودِ"
    },
    {
        "surah_number": 85,
        "verse_number": 6,
        "content": "إِذْ هُمْ عَلَيْهَا قُعُودٞ"
    },
    {
        "surah_number": 85,
        "verse_number": 7,
        "content": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٞۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 8,
        "content": "وَمَا نَقَمُواْ مِنْهُمْ إِلَّا أَنْ يُّؤْمِنُواْ بِاللَّهِ اِ۬لْعَزِيزِ اِ۬لْحَمِيدِ"
    },
    {
        "surah_number": 85,
        "verse_number": 9,
        "content": "اِ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِۖ وَاللَّهُ عَلَىٰ كُلِّ شَےْءٖ شَهِيدٌۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 10,
        "content": "إِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُؤْمِنِينَ وَالْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 11,
        "content": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٞ تَجْرِے مِن تَحْتِهَا اَ۬لْأَنْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 12,
        "content": "۞ إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 13,
        "content": "إِنَّهُۥ هُوَ يُبْدِۓُ وَيُعِيدُۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 14,
        "content": "وَهْوَ اَ۬لْغَفُورُ اُ۬لْوَدُودُ"
    },
    {
        "surah_number": 85,
        "verse_number": 15,
        "content": "ذُو اُ۬لْعَرْشِۖ اِ۬لْمَجِيدُ"
    },
    {
        "surah_number": 85,
        "verse_number": 16,
        "content": "فَعَّالٞ لِّمَا يُرِيدُۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 17,
        "content": "هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْجُنُودِ"
    },
    {
        "surah_number": 85,
        "verse_number": 18,
        "content": "فِرْعَوْنَ وَثَمُودَۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 19,
        "content": "بَلِ اِ۬لذِينَ كَفَرُواْ فِے تَكْذِيبٖ"
    },
    {
        "surah_number": 85,
        "verse_number": 20,
        "content": "وَاللَّهُ مِنْ وَّرَآئِهِم مُّحِيطُۢۖ"
    },
    {
        "surah_number": 85,
        "verse_number": 21,
        "content": "بَلْ هُوَ قُرْءَانٞ مَّجِيدٞ"
    },
    {
        "surah_number": 85,
        "verse_number": 22,
        "content": "فِے لَوْحٖ مَّحْفُوظُۢۖ"
    }
]