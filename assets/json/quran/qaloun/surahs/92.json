[
    {
        "surah_number": 92,
        "verse_number": 1,
        "content": "وَاليْلِ إِذَا يَغْشَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 2,
        "content": "وَالنَّهَارِ إِذَا تَجَلَّىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 3,
        "content": "وَمَا خَلَقَ اَ۬لذَّكَرَ وَالْأُنثَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 4,
        "content": "إِنَّ سَعْيَكُمْ لَشَتَّىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 5,
        "content": "فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 6,
        "content": "وَصَدَّقَ بِالْحُسْنَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 7,
        "content": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 8,
        "content": "وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْنَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 9,
        "content": "وَكَذَّبَ بِالْحُسْنَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 10,
        "content": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 11,
        "content": "وَمَا يُغْنِے عَنْهُ مَالُهُۥ إِذَا تَرَدَّىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 12,
        "content": "إِنَّ عَلَيْنَا لَلْهُدَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 13,
        "content": "وَإِنَّ لَنَا لَلْأٓخِرَةَ وَالْأُولَىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 14,
        "content": "فَأَنذَرْتُكُمْ نَاراٗ تَلَظَّىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 15,
        "content": "لَا يَصْلَيٰهَا إِلَّا اَ۬لْأَشْقَى"
    },
    {
        "surah_number": 92,
        "verse_number": 16,
        "content": "اَ۬لذِے كَذَّبَ وَتَوَلَّىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 17,
        "content": "وَسَيُجَنَّبُهَا اَ۬لْأَتْقَى"
    },
    {
        "surah_number": 92,
        "verse_number": 18,
        "content": "اَ۬لذِے يُؤْتِے مَالَهُۥ يَتَزَكَّىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 19,
        "content": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْزَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 20,
        "content": "إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لْأَعْلَىٰۖ"
    },
    {
        "surah_number": 92,
        "verse_number": 21,
        "content": "وَلَسَوْفَ يَرْضَىٰۖ"
    }
]