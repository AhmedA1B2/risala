[
    {
        "surah_number": 87,
        "verse_number": 1,
        "content": "سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى"
    },
    {
        "surah_number": 87,
        "verse_number": 2,
        "content": "اَ۬لذِے خَلَقَ فَسَوَّىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 3,
        "content": "وَالذِے قَدَّرَ فَهَدَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 4,
        "content": "وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 5,
        "content": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 6,
        "content": "سَنُقْرِئُكَ فَلَا تَنسَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 7,
        "content": "إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 8,
        "content": "وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 9,
        "content": "فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 10,
        "content": "سَيَذَّكَّرُ مَنْ يَّخْشَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 11,
        "content": "وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى"
    },
    {
        "surah_number": 87,
        "verse_number": 12,
        "content": "اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 13,
        "content": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 14,
        "content": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 15,
        "content": "وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 16,
        "content": "بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا"
    },
    {
        "surah_number": 87,
        "verse_number": 17,
        "content": "وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ"
    },
    {
        "surah_number": 87,
        "verse_number": 18,
        "content": "إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 19,
        "content": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ"
    }
]