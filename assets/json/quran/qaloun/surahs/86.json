        "verse_number": 10,
        "content": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ"
    },
    {
        "surah_number": 86,
        "verse_number": 11,
        "content": "وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ"
    },
    {
