[
    {
        "surah_number": 56,
        "verse_number": 1,
        "content": "إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ"
    },
    {
        "surah_number": 56,
        "verse_number": 2,
        "content": "لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 3,
        "content": "خَافِضَةٞ رَّافِعَةٌ"
    },
    {
        "surah_number": 56,
        "verse_number": 4,
        "content": "إِذَا رُجَّتِ اِ۬لْأَرْضُ رَجّاٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 5,
        "content": "وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 6,
        "content": "فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 7,
        "content": "وَكُنتُمْ أَزْوَٰجاٗ ثَلَٰثَةٗۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 8,
        "content": "فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ"
    },
    {
        "surah_number": 56,
        "verse_number": 9,
        "content": "مَا أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 10,
        "content": "وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ"
    },
    {
        "surah_number": 56,
        "verse_number": 11,
        "content": "مَا أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 12,
        "content": "وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 13,
        "content": "أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 14,
        "content": "فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 15,
        "content": "ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 16,
        "content": "وَقَلِيلٞ مِّنَ اَ۬لْأٓخِرِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 17,
        "content": "عَلَىٰ سُرُرٖ مَّوْضُونَةٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 18,
        "content": "مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 19,
        "content": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 20,
        "content": "بِأَكْوَابٖ وَأَبَارِيقَ"
    },
    {
        "surah_number": 56,
        "verse_number": 21,
        "content": "وَكَأْسٖ مِّن مَّعِينٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 22,
        "content": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 23,
        "content": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 24,
        "content": "وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 25,
        "content": "وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ"
    },
    {
        "surah_number": 56,
        "verse_number": 26,
        "content": "جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 27,
        "content": "لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَأْثِيماًۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 28,
        "content": "إِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 29,
        "content": "۞ وَأَصْحَٰبُ اُ۬لْيَمِينِ مَا أَصْحَٰبُ اُ۬لْيَمِينِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 30,
        "content": "فِے سِدْرٖ مَّخْضُودٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 31,
        "content": "وَطَلْحٖ مَّنضُودٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 32,
        "content": "وَظِلّٖ مَّمْدُودٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 33,
        "content": "وَمَآءٖ مَّسْكُوبٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 34,
        "content": "وَفَٰكِهَةٖ كَثِيرَةٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 35,
        "content": "لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 36,
        "content": "وَفُرُشٖ مَّرْفُوعَةٍۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 37,
        "content": "إِنَّا أَنشَأْنَٰهُنَّ إِنشَآءٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 38,
        "content": "فَجَعَلْنَٰهُنَّ أَبْكَاراً"
    },
    {
        "surah_number": 56,
        "verse_number": 39,
        "content": "عُرُباً أَتْرَاباٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 40,
        "content": "لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 41,
        "content": "ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 42,
        "content": "وَثُلَّةٞ مِّنَ اَ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 43,
        "content": "وَأَصْحَٰبُ اُ۬لشِّمَالِ"
    },
    {
        "surah_number": 56,
        "verse_number": 44,
        "content": "مَا أَصْحَٰبُ اُ۬لشِّمَالِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 45,
        "content": "فِے سَمُومٖ وَحَمِيمٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 46,
        "content": "وَظِلّٖ مِّنْ يَّحْمُومٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 47,
        "content": "لَّا بَارِدٖ وَلَا كَرِيمٍۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 48,
        "content": "إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 49,
        "content": "وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 50,
        "content": "وَكَانُواْ يَقُولُونَ أَٰئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 51,
        "content": "أَوْءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 52,
        "content": "قُلْ إِنَّ اَ۬لْأَوَّلِينَ وَالْأٓخِرِينَ لَمَجْمُوعُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 53,
        "content": "إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 54,
        "content": "ثُمَّ إِنَّكُمْ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 55,
        "content": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 56,
        "content": "فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 57,
        "content": "فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ"
    },
    {
        "surah_number": 56,
        "verse_number": 58,
        "content": "فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 59,
        "content": "هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 60,
        "content": "نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 61,
        "content": "أَفَرَٰ۬يْتُم مَّا تُمْنُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 62,
        "content": "ءَٰا۬نتُمْ تَخْلُقُونَهُۥ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 63,
        "content": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 64,
        "content": "عَلَىٰ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 65,
        "content": "وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لْأُولَىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 66,
        "content": "أَفَرَٰ۬يْتُم مَّا تَحْرُثُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 67,
        "content": "ءَٰا۬نتُمْ تَزْرَعُونَهُۥ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 68,
        "content": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 69,
        "content": "إِنَّا لَمُغْرَمُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 70,
        "content": "بَلْ نَحْنُ مَحْرُومُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 71,
        "content": "أَفَرَٰ۬يْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 72,
        "content": "ءَٰا۬نتُمْ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 73,
        "content": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗۖ فَلَوْلَا تَشْكُرُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 74,
        "content": "أَفَرَٰ۬يْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 75,
        "content": "ءَٰا۬نتُمْ أَنشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ اُ۬لْمُنشِـُٔونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 76,
        "content": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةٗ وَمَتَٰعاٗ لِّلْمُقْوِينَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 77,
        "content": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 78,
        "content": "۞ فَلَا أُقْسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ"
    },
    {
        "surah_number": 56,
        "verse_number": 79,
        "content": "وَإِنَّهُۥ لَقَسَمٞ لَّوْ تَعْلَمُونَ عَظِيمٌ"
    },
    {
        "surah_number": 56,
        "verse_number": 80,
        "content": "إِنَّهُۥ لَقُرْءَانٞ كَرِيمٞ"
    },
    {
        "surah_number": 56,
        "verse_number": 81,
        "content": "فِے كِتَٰبٖ مَّكْنُونٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 82,
        "content": "لَّا يَمَسُّهُۥ إِلَّا اَ۬لْمُطَهَّرُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 83,
        "content": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 84,
        "content": "أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 85,
        "content": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 86,
        "content": "فَلَوْلَا إِذَا بَلَغَتِ اِ۬لْحُلْقُومَ"
    },
    {
        "surah_number": 56,
        "verse_number": 87,
        "content": "وَأَنتُمْ حِينَئِذٖ تَنظُرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 88,
        "content": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 89,
        "content": "فَلَوْلَا إِن كُنتُمْ غَيْرَ مَدِينِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 90,
        "content": "تَرْجِعُونَهَا إِن كُنتُمْ صَٰدِقِينَۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 91,
        "content": "فَأَمَّا إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 92,
        "content": "فَرَوْحٞ وَرَيْحَانٞ وَجَنَّتُ نَعِيمٖۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 93,
        "content": "وَأَمَّا إِن كَانَ مِنْ أَصْحَٰبِ اِ۬لْيَمِينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 94,
        "content": "فَسَلَٰمٞ لَّكَ مِنْ أَصْحَٰبِ اِ۬لْيَمِينِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 95,
        "content": "وَأَمَّا إِن كَانَ مِنَ اَ۬لْمُكَذِّبِينَ اَ۬لضَّآلِّينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 96,
        "content": "فَنُزُلٞ مِّنْ حَمِيمٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 97,
        "content": "وَتَصْلِيَةُ جَحِيمٍۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 98,
        "content": "إِنَّ هَٰذَا لَهْوَ حَقُّ اُ۬لْيَقِينِۖ"
    },
    {
        "surah_number": 56,
        "verse_number": 99,
        "content": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"
    }
]