[
    {
        "surah_number": 79,
        "verse_number": 1,
        "content": "وَالنَّٰزِعَٰتِ غَرْقاٗ"
    },
    {
        "surah_number": 79,
        "verse_number": 2,
        "content": "وَالنَّٰشِطَٰتِ نَشْطاٗ"
    },
    {
        "surah_number": 79,
        "verse_number": 3,
        "content": "وَالسَّٰبِحَٰتِ سَبْحاٗ"
    },
    {
        "surah_number": 79,
        "verse_number": 4,
        "content": "فَالسَّٰبِقَٰتِ سَبْقاٗ"
    },
    {
        "surah_number": 79,
        "verse_number": 5,
        "content": "فَالْمُدَبِّرَٰتِ أَمْراٗ"
    },
    {
        "surah_number": 79,
        "verse_number": 6,
        "content": "يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ"
    },
    {
        "surah_number": 79,
        "verse_number": 7,
        "content": "تَتْبَعُهَا اَ۬لرَّادِفَةُۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 8,
        "content": "قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ"
    },
    {
        "surah_number": 79,
        "verse_number": 9,
        "content": "أَبْصَٰرُهَا خَٰشِعَةٞۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 10,
        "content": "يَقُولُونَ أَٰ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ"
    },
    {
        "surah_number": 79,
        "verse_number": 11,
        "content": "إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 12,
        "content": "قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ"
    },
    {
        "surah_number": 79,
        "verse_number": 13,
        "content": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ"
    },
    {
        "surah_number": 79,
        "verse_number": 14,
        "content": "فَإِذَا هُم بِالسَّاهِرَةِۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 15,
        "content": "هَلْ أَتَيٰكَ حَدِيثُ مُوسَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 16,
        "content": "إِذْ نَادَيٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 17,
        "content": "اَ۪ذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 18,
        "content": "فَقُلْ هَل لَّكَ إِلَىٰ أَن تَزَّكَّىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 19,
        "content": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 20,
        "content": "فَأَرَيٰهُ اُ۬لْأٓيَةَ اَ۬لْكُبْرَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 21,
        "content": "فَكَذَّبَ وَعَصَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 22,
        "content": "ثُمَّ أَدْبَرَ يَسْعَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 23,
        "content": "فَحَشَرَ فَنَادَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 24,
        "content": "فَقَالَ أَنَا رَبُّكُمُ اُ۬لْأَعْلَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 25,
        "content": "فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لْأٓخِرَةِ وَالْأُولَىٰۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 26,
        "content": "إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْشَىٰۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 27,
        "content": "ءَٰا۬نتُمْ أَشَدُّ خَلْقاً أَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 28,
        "content": "رَفَعَ سَمْكَهَا فَسَوَّيٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 29,
        "content": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 30,
        "content": "وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 31,
        "content": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 32,
        "content": "وَالْجِبَالَ أَرْسَيٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 33,
        "content": "مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 34,
        "content": "فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْرَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 35,
        "content": "يَوْمَ يَتَذَكَّرُ اُ۬لْإِنسَٰنُ مَا سَعَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 36,
        "content": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّرَىٰۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 37,
        "content": "فَأَمَّا مَن طَغَىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا"
    },
    {
        "surah_number": 79,
        "verse_number": 38,
        "content": "فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْوَىٰۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 39,
        "content": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَوَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 40,
        "content": "فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْوَىٰۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 41,
        "content": "۞ يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 42,
        "content": "فِيمَ أَنتَ مِن ذِكْرَيٰهَاۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 43,
        "content": "إِلَىٰ رَبِّكَ مُنتَهَيٰهَاۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 44,
        "content": "إِنَّمَا أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ"
    },
    {
        "surah_number": 79,
        "verse_number": 45,
        "content": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُواْ إِلَّا عَشِيَّةً أَوْ ضُحَيٰهَاۖ"
    }
]