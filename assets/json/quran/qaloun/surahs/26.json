[
    {
        "surah_number": 26,
        "verse_number": 1,
        "content": "طَسِٓمِّٓۖ تِلْكَ ءَايَٰتُ اُ۬لْكِتَٰبِ اِ۬لْمُبِينِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 2,
        "content": "لَعَلَّكَ بَٰخِعٞ نَّفْسَكَ أَلَّا يَكُونُواْ مُؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 3,
        "content": "إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ اَ۬لسَّمَآءِ اَ۟يَةٗ فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 4,
        "content": "وَمَا يَأْتِيهِم مِّن ذِكْرٖ مِّنَ اَ۬لرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُواْ عَنْهُ مُعْرِضِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 5,
        "content": "فَقَدْ كَذَّبُواْ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 6,
        "content": "أَوَلَمْ يَرَوْاْ إِلَى اَ۬لْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٖ كَرِيمٍۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 7,
        "content": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 8,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 9,
        "content": "وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰ أَنِ اِ۪ئْتِ اِ۬لْقَوْمَ اَ۬لظَّٰلِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 10,
        "content": "قَوْمَ فِرْعَوْنَۖ أَلَا يَتَّقُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 11,
        "content": "قَالَ رَبِّ إِنِّيَ أَخَافُ أَنْ يُّكَذِّبُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 12,
        "content": "وَيَضِيقُ صَدْرِے وَلَا يَنطَلِقُ لِسَانِے فَأَرْسِلْ إِلَىٰ هَٰرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 13,
        "content": "وَلَهُمْ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَنْ يَّقْتُلُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 14,
        "content": "قَالَ كَلَّاۖ فَاذْهَبَا بِـَٔايَٰتِنَا إِنَّا مَعَكُم مُّسْتَمِعُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 15,
        "content": "فَأْتِيَا فِرْعَوْنَ فَقُولَا إِنَّا رَسُولُ رَبِّ اِ۬لْعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 16,
        "content": "أَنْ أَرْسِلْ مَعَنَا بَنِے إِسْرَآءِيلَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 17,
        "content": "قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيداٗ وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 18,
        "content": "وَفَعَلْتَ فَعْلَتَكَ اَ۬لتِے فَعَلْتَ وَأَنتَ مِنَ اَ۬لْكَٰفِرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 19,
        "content": "قَالَ فَعَلْتُهَا إِذاٗ وَأَنَا مِنَ اَ۬لضَّآلِّينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 20,
        "content": "فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِے رَبِّے حُكْماٗ وَجَعَلَنِے مِنَ اَ۬لْمُرْسَلِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 21,
        "content": "وَتِلْكَ نِعْمَةٞ تَمُنُّهَا عَلَيَّ أَنْ عَبَّدتَّ بَنِے إِسْرَآءِيلَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 22,
        "content": "۞ قَالَ فِرْعَوْنُ وَمَا رَبُّ اُ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 23,
        "content": "قَالَ رَبُّ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا إِن كُنتُم مُّوقِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 24,
        "content": "قَالَ لِمَنْ حَوْلَهُۥ أَلَا تَسْتَمِعُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 25,
        "content": "قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لْأَوَّلِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 26,
        "content": "قَالَ إِنَّ رَسُولَكُمُ اُ۬لذِے أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 27,
        "content": "قَالَ رَبُّ اُ۬لْمَشْرِقِ وَالْمَغْرِبِ وَمَا بَيْنَهُمَا إِن كُنتُمْ تَعْقِلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 28,
        "content": "قَالَ لَئِنِ اِ۪تَّخَذتَّ إِلَٰهاً غَيْرِے لَأَجْعَلَنَّكَ مِنَ اَ۬لْمَسْجُونِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 29,
        "content": "قَالَ أَوَلَوْ جِئْتُكَ بِشَےْءٖ مُّبِينٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 30,
        "content": "قَالَ فَأْتِ بِهِۦ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 31,
        "content": "فَأَلْقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعْبَانٞ مُّبِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 32,
        "content": "وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيْضَآءُ لِلنَّٰظِرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 33,
        "content": "قَالَ لِلْمَلَإِ حَوْلَهُۥ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 34,
        "content": "يُرِيدُ أَنْ يُّخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 35,
        "content": "قَالُواْ أَرْجِهِ وَأَخَاهُ وَابْعَثْ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 36,
        "content": "يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 37,
        "content": "فَجُمِعَ اَ۬لسَّحَرَةُ لِمِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 38,
        "content": "وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 39,
        "content": "لَعَلَّنَا نَتَّبِعُ اُ۬لسَّحَرَةَ إِن كَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 40,
        "content": "فَلَمَّا جَآءَ اَ۬لسَّحَرَةُ قَالُواْ لِفِرْعَوْنَ أَٰئِنَّ لَنَا لَأَجْراً إِن كُنَّا نَحْنُ اُ۬لْغَٰلِبِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 41,
        "content": "قَالَ نَعَمْ وَإِنَّكُمْ إِذاٗ لَّمِنَ اَ۬لْمُقَرَّبِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 42,
        "content": "قَالَ لَهُم مُّوسَىٰ أَلْقُواْ مَا أَنتُم مُّلْقُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 43,
        "content": "فَأَلْقَوْاْ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُواْ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ اُ۬لْغَٰلِبُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 44,
        "content": "فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِيَ تَلَقَّفُ مَا يَأْفِكُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 45,
        "content": "فَأُلْقِيَ اَ۬لسَّحَرَةُ سَٰجِدِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 46,
        "content": "قَالُواْ ءَامَنَّا بِرَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 47,
        "content": "رَبِّ مُوسَىٰ وَهَٰرُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 48,
        "content": "قَالَ ءَاٰ۬مَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ إِنَّهُۥ لَكَبِيرُكُمُ اُ۬لذِے عَلَّمَكُمُ اُ۬لسِّحْرَۖ فَلَسَوْفَ تَعْلَمُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 49,
        "content": "لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 50,
        "content": "۞ قَالُواْ لَا ضَيْرَۖ إِنَّا إِلَىٰ رَبِّنَا مُنقَلِبُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 51,
        "content": "إِنَّا نَطْمَعُ أَنْ يَّغْفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَا أَن كُنَّا أَوَّلَ اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 52,
        "content": "وَأَوْحَيْنَا إِلَىٰ مُوسَىٰ أَنِ اِ۪سْرِ بِعِبَادِيَ إِنَّكُم مُّتَّبَعُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 53,
        "content": "فَأَرْسَلَ فِرْعَوْنُ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 54,
        "content": "إِنَّ هَٰؤُلَآءِ لَشِرْذِمَةٞ قَلِيلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 55,
        "content": "وَإِنَّهُمْ لَنَا لَغَآئِظُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 56,
        "content": "وَإِنَّا لَجَمِيعٌ حَذِرُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 57,
        "content": "فَأَخْرَجْنَٰهُم مِّن جَنَّٰتٖ وَعُيُونٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 58,
        "content": "وَكُنُوزٖ وَمَقَامٖ كَرِيمٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 59,
        "content": "كَذَٰلِكَۖ وَأَوْرَثْنَٰهَا بَنِے إِسْرَآءِيلَ"
    },
    {
        "surah_number": 26,
        "verse_number": 60,
        "content": "فَأَتْبَعُوهُم مُّشْرِقِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 61,
        "content": "فَلَمَّا تَرَٰٓءَا اَ۬لْجَمْعَٰنِ قَالَ أَصْحَٰبُ مُوسَىٰ إِنَّا لَمُدْرَكُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 62,
        "content": "قَالَ كَلَّاۖ إِنَّ مَعِے رَبِّے سَيَهْدِينِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 63,
        "content": "فَأَوْحَيْنَا إِلَىٰ مُوسَىٰ أَنِ اِ۪ضْرِب بِّعَصَاكَ اَ۬لْبَحْرَ فَانفَلَقَ فَكَانَ كُلُّ فِرْقٖ كَالطَّوْدِ اِ۬لْعَظِيمِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 64,
        "content": "وَأَزْلَفْنَا ثَمَّ اَ۬لْأٓخَرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 65,
        "content": "وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥ أَجْمَعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 66,
        "content": "ثُمَّ أَغْرَقْنَا اَ۬لْأٓخَرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 67,
        "content": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 68,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 69,
        "content": "وَاتْلُ عَلَيْهِمْ نَبَأَ ا۪بْرَٰهِيمَ"
    },
    {
        "surah_number": 26,
        "verse_number": 70,
        "content": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 71,
        "content": "قَالُواْ نَعْبُدُ أَصْنَاماٗ فَنَظَلُّ لَهَا عَٰكِفِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 72,
        "content": "قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 73,
        "content": "أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 74,
        "content": "قَالُواْ بَلْ وَجَدْنَا ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 75,
        "content": "قَالَ أَفَرَٰ۬يْتُم مَّا كُنتُمْ تَعْبُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 76,
        "content": "أَنتُمْ وَءَابَآؤُكُمُ اُ۬لْأَقْدَمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 77,
        "content": "فَإِنَّهُمْ عَدُوّٞ لِّيَۖ إِلَّا رَبَّ اَ۬لْعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 78,
        "content": "۞ اَ۬لذِے خَلَقَنِے فَهْوَ يَهْدِينِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 79,
        "content": "وَالذِے هُوَ يُطْعِمُنِے وَيَسْقِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 80,
        "content": "وَإِذَا مَرِضْتُ فَهْوَ يَشْفِينِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 81,
        "content": "وَالذِے يُمِيتُنِے ثُمَّ يُحْيِينِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 82,
        "content": "وَالذِے أَطْمَعُ أَنْ يَّغْفِرَ لِے خَطِيَٓٔتِے يَوْمَ اَ۬لدِّينِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 83,
        "content": "رَبِّ هَبْ لِے حُكْماٗ وَأَلْحِقْنِے بِالصَّٰلِحِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 84,
        "content": "وَاجْعَل لِّے لِسَانَ صِدْقٖ فِے اِ۬لْأٓخِرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 85,
        "content": "وَاجْعَلْنِے مِنْ وَّرَثَةِ جَنَّةِ اِ۬لنَّعِيمِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 86,
        "content": "وَاغْفِرْ لِأَبِيَ إِنَّهُۥ كَانَ مِنَ اَ۬لضَّآلِّينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 87,
        "content": "وَلَا تُخْزِنِے يَوْمَ يُبْعَثُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 88,
        "content": "يَوْمَ لَا يَنفَعُ مَالٞ وَلَا بَنُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 89,
        "content": "إِلَّا مَنْ أَتَى اَ۬للَّهَ بِقَلْبٖ سَلِيمٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 90,
        "content": "وَأُزْلِفَتِ اِ۬لْجَنَّةُ لِلْمُتَّقِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 91,
        "content": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِلْغَاوِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 92,
        "content": "وَقِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 93,
        "content": "مِن دُونِ اِ۬للَّهِۖ هَلْ يَنصُرُونَكُمْ أَوْ يَنتَصِرُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 94,
        "content": "فَكُبْكِبُواْ فِيهَا هُمْ وَالْغَاوُۥنَ"
    },
    {
        "surah_number": 26,
        "verse_number": 95,
        "content": "وَجُنُودُ إِبْلِيسَ أَجْمَعُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 96,
        "content": "قَالُواْ وَهُمْ فِيهَا يَخْتَصِمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 97,
        "content": "تَاللَّهِ إِن كُنَّا لَفِے ضَلَٰلٖ مُّبِينٍ"
    },
    {
        "surah_number": 26,
        "verse_number": 98,
        "content": "إِذْ نُسَوِّيكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 99,
        "content": "وَمَا أَضَلَّنَا إِلَّا اَ۬لْمُجْرِمُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 100,
        "content": "فَمَا لَنَا مِن شَٰفِعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 101,
        "content": "وَلَا صَدِيقٍ حَمِيمٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 102,
        "content": "فَلَوْ أَنَّ لَنَا كَرَّةٗ فَنَكُونَ مِنَ اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 103,
        "content": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 104,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 105,
        "content": "كَذَّبَتْ قَوْمُ نُوحٍ اِ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 106,
        "content": "إِذْ قَالَ لَهُمْ أَخُوهُمْ نُوحٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 107,
        "content": "إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 108,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 109,
        "content": "وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 110,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 111,
        "content": "۞ قَالُواْ أَنُؤْمِنُ لَكَ وَاتَّبَعَكَ اَ۬لْأَرْذَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 112,
        "content": "قَالَ وَمَا عِلْمِے بِمَا كَانُواْ يَعْمَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 113,
        "content": "إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّے لَوْ تَشْعُرُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 114,
        "content": "وَمَا أَنَا بِطَارِدِ اِ۬لْمُؤْمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 115,
        "content": "إِنْ أَنَا إِلَّا نَذِيرٞ مُّبِينٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 116,
        "content": "قَالُواْ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ اَ۬لْمَرْجُومِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 117,
        "content": "قَالَ رَبِّ إِنَّ قَوْمِے كَذَّبُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 118,
        "content": "فَافْتَحْ بَيْنِے وَبَيْنَهُمْ فَتْحاٗ وَنَجِّنِے وَمَن مَّعِے مِنَ اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 119,
        "content": "فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 120,
        "content": "ثُمَّ أَغْرَقْنَا بَعْدُ اُ۬لْبَاقِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 121,
        "content": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 122,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 123,
        "content": "كَذَّبَتْ عَادٌ اِ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 124,
        "content": "إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 125,
        "content": "إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 126,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 127,
        "content": "وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 128,
        "content": "أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةٗ تَعْبَثُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 129,
        "content": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 130,
        "content": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 131,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 132,
        "content": "وَاتَّقُواْ اُ۬لذِے أَمَدَّكُم بِمَا تَعْلَمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 133,
        "content": "أَمَدَّكُم بِأَنْعَٰمٖ وَبَنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 134,
        "content": "وَجَنَّٰتٖ وَعُيُونٍۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 135,
        "content": "إِنِّيَ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 136,
        "content": "قَالُواْ سَوَآءٌ عَلَيْنَا أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ اَ۬لْوَٰعِظِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 137,
        "content": "إِنْ هَٰذَا إِلَّا خُلُقُ اُ۬لْأَوَّلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 138,
        "content": "وَمَا نَحْنُ بِمُعَذَّبِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 139,
        "content": "فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 140,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 141,
        "content": "كَذَّبَتْ ثَمُودُ اُ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 142,
        "content": "إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 143,
        "content": "إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 144,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 145,
        "content": "وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 146,
        "content": "۞ أَتُتْرَكُونَ فِے مَا هَٰهُنَا ءَامِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 147,
        "content": "فِے جَنَّٰتٖ وَعُيُونٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 148,
        "content": "وَزُرُوعٖ وَنَخْلٖ طَلْعُهَا هَضِيمٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 149,
        "content": "وَتَنْحِتُونَ مِنَ اَ۬لْجِبَالِ بِيُوتاٗ فَرِهِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 150,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 151,
        "content": "وَلَا تُطِيعُواْ أَمْرَ اَ۬لْمُسْرِفِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 152,
        "content": "اَ۬لذِينَ يُفْسِدُونَ فِے اِ۬لْأَرْضِ وَلَا يُصْلِحُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 153,
        "content": "قَالُواْ إِنَّمَا أَنتَ مِنَ اَ۬لْمُسَحَّرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 154,
        "content": "مَا أَنتَ إِلَّا بَشَرٞ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 155,
        "content": "قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرْبٞۖ وَلَكُمْ شِرْبُ يَوْمٖ مَّعْلُومٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 156,
        "content": "وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 157,
        "content": "فَعَقَرُوهَا فَأَصْبَحُواْ نَٰدِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 158,
        "content": "فَأَخَذَهُمُ اُ۬لْعَذَابُۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 159,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 160,
        "content": "كَذَّبَتْ قَوْمُ لُوطٍ اِ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 161,
        "content": "إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 162,
        "content": "إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 163,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 164,
        "content": "وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 165,
        "content": "أَتَأْتُونَ اَ۬لذُّكْرَانَ مِنَ اَ۬لْعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 166,
        "content": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُمۖ بَلْ أَنتُمْ قَوْمٌ عَادُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 167,
        "content": "قَالُواْ لَئِن لَّمْ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ اَ۬لْمُخْرَجِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 168,
        "content": "قَالَ إِنِّے لِعَمَلِكُم مِّنَ اَ۬لْقَالِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 169,
        "content": "رَبِّ نَجِّنِے وَأَهْلِے مِمَّا يَعْمَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 170,
        "content": "فَنَجَّيْنَٰهُ وَأَهْلَهُۥ أَجْمَعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 171,
        "content": "إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 172,
        "content": "ثُمَّ دَمَّرْنَا اَ۬لْأٓخَرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 173,
        "content": "وَأَمْطَرْنَا عَلَيْهِم مَّطَراٗۖ فَسَآءَ مَطَرُ اُ۬لْمُنذَرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 174,
        "content": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 175,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 176,
        "content": "كَذَّبَ أَصْحَٰبُ لَيْكَةَ اَ۬لْمُرْسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 177,
        "content": "إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 178,
        "content": "إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 179,
        "content": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 180,
        "content": "وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 181,
        "content": "۞ أَوْفُواْ اُ۬لْكَيْلَۖ وَلَا تَكُونُواْ مِنَ اَ۬لْمُخْسِرِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 182,
        "content": "وَزِنُواْ بِالْقُسْطَاسِ اِ۬لْمُسْتَقِيمِۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 183,
        "content": "وَلَا تَبْخَسُواْ اُ۬لنَّاسَ أَشْيَآءَهُمْۖ وَلَا تَعْثَوْاْ فِے اِ۬لْأَرْضِ مُفْسِدِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 184,
        "content": "وَاتَّقُواْ اُ۬لذِے خَلَقَكُمْ وَالْجِبِلَّةَ اَ۬لْأَوَّلِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 185,
        "content": "قَالُواْ إِنَّمَا أَنتَ مِنَ اَ۬لْمُسَحَّرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 186,
        "content": "وَمَا أَنتَ إِلَّا بَشَرٞ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ اَ۬لْكَٰذِبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 187,
        "content": "فَأَسْقِطْ عَلَيْنَا كِسْفاٗ مِّنَ اَ۬لسَّمَآ۟ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 188,
        "content": "قَالَ رَبِّيَ أَعْلَمُ بِمَا تَعْمَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 189,
        "content": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ اِ۬لظُّلَّةِۖ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 190,
        "content": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 191,
        "content": "وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 192,
        "content": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 193,
        "content": "نَزَلَ بِهِ اِ۬لرُّوحُ اُ۬لْأَمِينُ"
    },
    {
        "surah_number": 26,
        "verse_number": 194,
        "content": "عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ اَ۬لْمُنذِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 195,
        "content": "بِلِسَانٍ عَرَبِيّٖ مُّبِينٖۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 196,
        "content": "وَإِنَّهُۥ لَفِے زُبُرِ اِ۬لْأَوَّلِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 197,
        "content": "أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَنْ يَّعْلَمَهُۥ عُلَمَٰٓؤُاْ بَنِے إِسْرَآءِيلَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 198,
        "content": "وَلَوْ نَزَّلْنَٰهُ عَلَىٰ بَعْضِ اِ۬لْأَعْجَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 199,
        "content": "فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُواْ بِهِۦ مُؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 200,
        "content": "كَذَٰلِكَ سَلَكْنَٰهُ فِے قُلُوبِ اِ۬لْمُجْرِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 201,
        "content": "لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ اُ۬لْعَذَابَ اَ۬لْأَلِيمَ"
    },
    {
        "surah_number": 26,
        "verse_number": 202,
        "content": "فَيَأْتِيَهُم بَغْتَةٗ وَهُمْ لَا يَشْعُرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 203,
        "content": "فَيَقُولُواْ هَلْ نَحْنُ مُنظَرُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 204,
        "content": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 205,
        "content": "أَفَرَٰ۬يْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 206,
        "content": "ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 207,
        "content": "مَا أَغْنَىٰ عَنْهُم مَّا كَانُواْ يُمَتَّعُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 208,
        "content": "۞ وَمَا أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 209,
        "content": "ذِكْرَىٰۖ وَمَا كُنَّا ظَٰلِمِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 210,
        "content": "وَمَا تَنَزَّلَتْ بِهِ اِ۬لشَّيَٰطِينُ وَمَا يَنۢبَغِے لَهُمْ وَمَا يَسْتَطِيعُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 211,
        "content": "إِنَّهُمْ عَنِ اِ۬لسَّمْعِ لَمَعْزُولُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 212,
        "content": "فَلَا تَدْعُ مَعَ اَ۬للَّهِ إِلَٰهاً ءَاخَرَ فَتَكُونَ مِنَ اَ۬لْمُعَذَّبِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 213,
        "content": "وَأَنذِرْ عَشِيرَتَكَ اَ۬لْأَقْرَبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 214,
        "content": "وَاخْفِضْ جَنَاحَكَ لِمَنِ اِ۪تَّبَعَكَ مِنَ اَ۬لْمُؤْمِنِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 215,
        "content": "فَإِنْ عَصَوْكَ فَقُلْ إِنِّے بَرِےٓءٞ مِّمَّا تَعْمَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 216,
        "content": "فَتَوَكَّلْ عَلَى اَ۬لْعَزِيزِ اِ۬لرَّحِيمِ"
    },
    {
        "surah_number": 26,
        "verse_number": 217,
        "content": "اِ۬لذِے يَرَيٰكَ حِينَ تَقُومُ"
    },
    {
        "surah_number": 26,
        "verse_number": 218,
        "content": "وَتَقَلُّبَكَ فِے اِ۬لسَّٰجِدِينَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 219,
        "content": "إِنَّهُۥ هُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 220,
        "content": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ اُ۬لشَّيَٰطِينُ"
    },
    {
        "surah_number": 26,
        "verse_number": 221,
        "content": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 222,
        "content": "يُلْقُونَ اَ۬لسَّمْعَ وَأَكْثَرُهُمْ كَٰذِبُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 223,
        "content": "وَالشُّعَرَآءُ يَتْبَعُهُمُ اُ۬لْغَاوُۥنَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 224,
        "content": "أَلَمْ تَرَ أَنَّهُمْ فِے كُلِّ وَادٖ يَهِيمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 225,
        "content": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَۖ"
    },
    {
        "surah_number": 26,
        "verse_number": 226,
        "content": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَذَكَرُواْ اُ۬للَّهَ كَثِيراٗ وَانتَصَرُواْ مِنۢ بَعْدِ مَا ظُلِمُواْۖ وَسَيَعْلَمُ اُ۬لذِينَ ظَلَمُواْ أَيَّ مُنقَلَبٖ يَنقَلِبُونَۖ"
    }
]