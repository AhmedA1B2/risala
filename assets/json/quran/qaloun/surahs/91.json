[
    {
        "surah_number": 91,
        "verse_number": 1,
        "content": "وَالشَّمْسِ وَضُحَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 2,
        "content": "وَالْقَمَرِ إِذَا تَلَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 3,
        "content": "وَالنَّهَارِ إِذَا جَلَّيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 4,
        "content": "وَاليْلِ إِذَا يَغْشَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 5,
        "content": "وَالسَّمَآءِ وَمَا بَنَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 6,
        "content": "وَالْأَرْضِ وَمَا طَحَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 7,
        "content": "وَنَفْسٖ وَمَا سَوَّيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 8,
        "content": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 9,
        "content": "قَدْ أَفْلَحَ مَن زَكَّيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 10,
        "content": "وَقَدْ خَابَ مَن دَسَّيٰهَاۖ"
    },
    {
        "surah_number": 91,
        "verse_number": 11,
        "content": "كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 12,
        "content": "إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 13,
        "content": "فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا"
    },
    {
        "surah_number": 91,
        "verse_number": 14,
        "content": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ"
    },
    {
        "surah_number": 91,
        "verse_number": 15,
        "content": "فَلَا يَخَافُ عُقْبَٰهَاۖ"
    }
]