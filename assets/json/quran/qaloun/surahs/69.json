[
    {
        "surah_number": 69,
        "verse_number": 1,
        "content": "اِ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 2,
        "content": "وَمَا أَدْرَيٰكَ مَا اَ۬لْحَآقَّةُۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 3,
        "content": "كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 4,
        "content": "فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 5,
        "content": "وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ"
    },
    {
        "surah_number": 69,
        "verse_number": 6,
        "content": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 7,
        "content": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 8,
        "content": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُؤْتَفِكَٰتُ بِالْخَاطِئَةِ"
    },
    {
        "surah_number": 69,
        "verse_number": 9,
        "content": "فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةٗ رَّابِيَةًۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 10,
        "content": "إِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ"
    },
    {
        "surah_number": 69,
        "verse_number": 11,
        "content": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَا أُذْنٞ وَٰعِيَةٞۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 12,
        "content": "فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ"
    },
    {
        "surah_number": 69,
        "verse_number": 13,
        "content": "وَحُمِلَتِ اِ۬لْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ"
    },
    {
        "surah_number": 69,
        "verse_number": 14,
        "content": "فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ"
    },
    {
        "surah_number": 69,
        "verse_number": 15,
        "content": "وَانشَقَّتِ اِ۬لسَّمَآءُ فَهْيَ يَوْمَئِذٖ وَاهِيَةٞ"
    },
    {
        "surah_number": 69,
        "verse_number": 16,
        "content": "وَالْمَلَكُ عَلَىٰ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ"
    },
    {
        "surah_number": 69,
        "verse_number": 17,
        "content": "يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٞۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 18,
        "content": "فَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 19,
        "content": "إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 20,
        "content": "فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖ"
    },
    {
        "surah_number": 69,
        "verse_number": 21,
        "content": "فِے جَنَّةٍ عَالِيَةٖ"
    },
    {
        "surah_number": 69,
        "verse_number": 22,
        "content": "قُطُوفُهَا دَانِيَةٞۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 23,
        "content": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا أَسْلَفْتُمْ فِے اِ۬لْأَيَّامِ اِ۬لْخَالِيَةِۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 24,
        "content": "وَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ"
    },
    {
        "surah_number": 69,
        "verse_number": 25,
        "content": "فَيَقُولُ يَٰلَيْتَنِے لَمْ أُوتَ كِتَٰبِيَهْۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 26,
        "content": "وَلَمْ أَدْرِ مَا حِسَابِيَهْۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 27,
        "content": "يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ"
    },
    {
        "surah_number": 69,
        "verse_number": 28,
        "content": "مَا أَغْنَىٰ عَنِّے مَالِيَهۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 29,
        "content": "هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 30,
        "content": "خُذُوهُ فَغُلُّوهُ"
    },
    {
        "surah_number": 69,
        "verse_number": 31,
        "content": "ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ"
    },
    {
        "surah_number": 69,
        "verse_number": 32,
        "content": "ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 33,
        "content": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِاللَّهِ اِ۬لْعَظِيمِ"
    },
    {
        "surah_number": 69,
        "verse_number": 34,
        "content": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 35,
        "content": "فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ"
    },
    {
        "surah_number": 69,
        "verse_number": 36,
        "content": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٖ"
    },
    {
        "surah_number": 69,
        "verse_number": 37,
        "content": "لَّا يَأْكُلُهُۥ إِلَّا اَ۬لْخَٰطِـُٔونَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 38,
        "content": "۞ فَلَا أُقْسِمُ بِمَا تُبْصِرُونَ"
    },
    {
        "surah_number": 69,
        "verse_number": 39,
        "content": "وَمَا لَا تُبْصِرُونَ"
    },
    {
        "surah_number": 69,
        "verse_number": 40,
        "content": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ"
    },
    {
        "surah_number": 69,
        "verse_number": 41,
        "content": "وَمَا هُوَ بِقَوْلِ شَاعِرٖ قَلِيلاٗ مَّا تُؤْمِنُونَ"
    },
    {
        "surah_number": 69,
        "verse_number": 42,
        "content": "وَلَا بِقَوْلِ كَاهِنٖۖ قَلِيلاٗ مَّا تَذَّكَّرُونَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 43,
        "content": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 44,
        "content": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ اَ۬لْأَقَاوِيلِ"
    },
    {
        "surah_number": 69,
        "verse_number": 45,
        "content": "لَأَخَذْنَا مِنْهُ بِالْيَمِينِ"
    },
    {
        "surah_number": 69,
        "verse_number": 46,
        "content": "ثُمَّ لَقَطَعْنَا مِنْهُ اُ۬لْوَتِينَ"
    },
    {
        "surah_number": 69,
        "verse_number": 47,
        "content": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 48,
        "content": "وَإِنَّهُۥ لَتَذْكِرَةٞ لِّلْمُتَّقِينَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 49,
        "content": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 50,
        "content": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى اَ۬لْكَٰفِرِينَۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 51,
        "content": "وَإِنَّهُۥ لَحَقُّ اُ۬لْيَقِينِۖ"
    },
    {
        "surah_number": 69,
        "verse_number": 52,
        "content": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"
    }
]