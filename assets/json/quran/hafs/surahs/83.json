[
    {
        "surah_number": 83,
        "verse_number": 1,
        "content": "وَيۡلٞ لِّلۡمُطَفِّفِينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 2,
        "content": "ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 3,
        "content": "وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 4,
        "content": "أَلَا يَظُنُّ أُوْلَـٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 5,
        "content": "لِيَوۡمٍ عَظِيمٖ"
    },
    {
        "surah_number": 83,
        "verse_number": 6,
        "content": "يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 7,
        "content": "كَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ"
    },
    {
        "surah_number": 83,
        "verse_number": 8,
        "content": "وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ"
    },
    {
        "surah_number": 83,
        "verse_number": 9,
        "content": "كِتَٰبٞ مَّرۡقُومٞ"
    },
    {
        "surah_number": 83,
        "verse_number": 10,
        "content": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 11,
        "content": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ"
    },
    {
        "surah_number": 83,
        "verse_number": 12,
        "content": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ"
    },
    {
        "surah_number": 83,
        "verse_number": 13,
        "content": "إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 14,
        "content": "كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 15,
        "content": "كَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 16,
        "content": "ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ"
    },
    {
        "surah_number": 83,
        "verse_number": 17,
        "content": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 18,
        "content": "كَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 19,
        "content": "وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 20,
        "content": "كِتَٰبٞ مَّرۡقُومٞ"
    },
    {
        "surah_number": 83,
        "verse_number": 21,
        "content": "يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 22,
        "content": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ"
    },
    {
        "surah_number": 83,
        "verse_number": 23,
        "content": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 24,
        "content": "تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ"
    },
    {
        "surah_number": 83,
        "verse_number": 25,
        "content": "يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ"
    },
    {
        "surah_number": 83,
        "verse_number": 26,
        "content": "خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 27,
        "content": "وَمِزَاجُهُۥ مِن تَسۡنِيمٍ"
    },
    {
        "surah_number": 83,
        "verse_number": 28,
        "content": "عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 29,
        "content": "إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 30,
        "content": "وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 31,
        "content": "وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 32,
        "content": "وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 33,
        "content": "وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ"
    },
    {
        "surah_number": 83,
        "verse_number": 34,
        "content": "فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 35,
        "content": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ"
    },
    {
        "surah_number": 83,
        "verse_number": 36,
        "content": "هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ"
    }
]