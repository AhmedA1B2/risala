[
    {
        "surah_number": 80,
        "verse_number": 1,
        "content": "عَبَسَ وَتَوَلَّىٰٓ"
    },
    {
        "surah_number": 80,
        "verse_number": 2,
        "content": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 3,
        "content": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"
    },
    {
        "surah_number": 80,
        "verse_number": 4,
        "content": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ"
    },
    {
        "surah_number": 80,
        "verse_number": 5,
        "content": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 6,
        "content": "فَأَنتَ لَهُۥ تَصَدَّىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 7,
        "content": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 8,
        "content": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 9,
        "content": "وَهُوَ يَخۡشَىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 10,
        "content": "فَأَنتَ عَنۡهُ تَلَهَّىٰ"
    },
    {
        "surah_number": 80,
        "verse_number": 11,
        "content": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ"
    },
    {
        "surah_number": 80,
        "verse_number": 12,
        "content": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 13,
        "content": "فِي صُحُفٖ مُّكَرَّمَةٖ"
    },
    {
        "surah_number": 80,
        "verse_number": 14,
        "content": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ"
    },
    {
        "surah_number": 80,
        "verse_number": 15,
        "content": "بِأَيۡدِي سَفَرَةٖ"
    },
    {
        "surah_number": 80,
        "verse_number": 16,
        "content": "كِرَامِۭ بَرَرَةٖ"
    },
    {
        "surah_number": 80,
        "verse_number": 17,
        "content": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 18,
        "content": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 19,
        "content": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 20,
        "content": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 21,
        "content": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 22,
        "content": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 23,
        "content": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ"
    },
    {
        "surah_number": 80,
        "verse_number": 24,
        "content": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"
    },
    {
        "surah_number": 80,
        "verse_number": 25,
        "content": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 26,
        "content": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 27,
        "content": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 28,
        "content": "وَعِنَبٗا وَقَضۡبٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 29,
        "content": "وَزَيۡتُونٗا وَنَخۡلٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 30,
        "content": "وَحَدَآئِقَ غُلۡبٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 31,
        "content": "وَفَٰكِهَةٗ وَأَبّٗا"
    },
    {
        "surah_number": 80,
        "verse_number": 32,
        "content": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"
    },
    {
        "surah_number": 80,
        "verse_number": 33,
        "content": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"
    },
    {
        "surah_number": 80,
        "verse_number": 34,
        "content": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ"
    },
    {
        "surah_number": 80,
        "verse_number": 35,
        "content": "وَأُمِّهِۦ وَأَبِيهِ"
    },
    {
        "surah_number": 80,
        "verse_number": 36,
        "content": "وَصَٰحِبَتِهِۦ وَبَنِيهِ"
    },
    {
        "surah_number": 80,
        "verse_number": 37,
        "content": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ"
    },
    {
        "surah_number": 80,
        "verse_number": 38,
        "content": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ"
    },
    {
        "surah_number": 80,
        "verse_number": 39,
        "content": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ"
    },
    {
        "surah_number": 80,
        "verse_number": 40,
        "content": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ"
    },
    {
        "surah_number": 80,
        "verse_number": 41,
        "content": "تَرۡهَقُهَا قَتَرَةٌ"
    },
    {
        "surah_number": 80,
        "verse_number": 42,
        "content": "أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ"
    }
]