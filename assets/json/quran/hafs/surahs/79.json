[
    {
        "surah_number": 79,
        "verse_number": 1,
        "content": "وَٱلنَّـٰزِعَٰتِ غَرۡقٗا"
    },
    {
        "surah_number": 79,
        "verse_number": 2,
        "content": "وَٱلنَّـٰشِطَٰتِ نَشۡطٗا"
    },
    {
        "surah_number": 79,
        "verse_number": 3,
        "content": "وَٱلسَّـٰبِحَٰتِ سَبۡحٗا"
    },
    {
        "surah_number": 79,
        "verse_number": 4,
        "content": "فَٱلسَّـٰبِقَٰتِ سَبۡقٗا"
    },
    {
        "surah_number": 79,
        "verse_number": 5,
        "content": "فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا"
    },
    {
        "surah_number": 79,
        "verse_number": 6,
        "content": "يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ"
    },
    {
        "surah_number": 79,
        "verse_number": 7,
        "content": "تَتۡبَعُهَا ٱلرَّادِفَةُ"
    },
    {
        "surah_number": 79,
        "verse_number": 8,
        "content": "قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ"
    },
    {
        "surah_number": 79,
        "verse_number": 9,
        "content": "أَبۡصَٰرُهَا خَٰشِعَةٞ"
    },
    {
        "surah_number": 79,
        "verse_number": 10,
        "content": "يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ"
    },
    {
        "surah_number": 79,
        "verse_number": 11,
        "content": "أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ"
    },
    {
        "surah_number": 79,
        "verse_number": 12,
        "content": "قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ"
    },
    {
        "surah_number": 79,
        "verse_number": 13,
        "content": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ"
    },
    {
        "surah_number": 79,
        "verse_number": 14,
        "content": "فَإِذَا هُم بِٱلسَّاهِرَةِ"
    },
    {
        "surah_number": 79,
        "verse_number": 15,
        "content": "هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"
    },
    {
        "surah_number": 79,
        "verse_number": 16,
        "content": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى"
    },
    {
        "surah_number": 79,
        "verse_number": 17,
        "content": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 18,
        "content": "فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 19,
        "content": "وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 20,
        "content": "فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 21,
        "content": "فَكَذَّبَ وَعَصَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 22,
        "content": "ثُمَّ أَدۡبَرَ يَسۡعَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 23,
        "content": "فَحَشَرَ فَنَادَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 24,
        "content": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 25,
        "content": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ"
    },
    {
        "surah_number": 79,
        "verse_number": 26,
        "content": "إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ"
    },
    {
        "surah_number": 79,
        "verse_number": 27,
        "content": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 28,
        "content": "رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 29,
        "content": "وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 30,
        "content": "وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ"
    },
    {
        "surah_number": 79,
        "verse_number": 31,
        "content": "أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 32,
        "content": "وَٱلۡجِبَالَ أَرۡسَىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 33,
        "content": "مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"
    },
    {
        "surah_number": 79,
        "verse_number": 34,
        "content": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 35,
        "content": "يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 36,
        "content": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 37,
        "content": "فَأَمَّا مَن طَغَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 38,
        "content": "وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"
    },
    {
        "surah_number": 79,
        "verse_number": 39,
        "content": "فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 40,
        "content": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 41,
        "content": "فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ"
    },
    {
        "surah_number": 79,
        "verse_number": 42,
        "content": "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 43,
        "content": "فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ"
    },
    {
        "surah_number": 79,
        "verse_number": 44,
        "content": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"
    },
    {
        "surah_number": 79,
        "verse_number": 45,
        "content": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا"
    },
    {
        "surah_number": 79,
        "verse_number": 46,
        "content": "كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا"
    }
]