[
    {
        "surah_number": 78,
        "verse_number": 1,
        "content": "عَمَّ يَتَسَآءَلُوَ"
    },
    {
        "surah_number": 78,
        "verse_number": 2,
        "content": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ"
    },
    {
        "surah_number": 78,
        "verse_number": 3,
        "content": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ"
    },
    {
        "surah_number": 78,
        "verse_number": 4,
        "content": "كَلَّا سَيَعۡلَمُونَ"
    },
    {
        "surah_number": 78,
        "verse_number": 5,
        "content": "ثُمَّ كَلَّا سَيَعۡلَمُونَ"
    },
    {
        "surah_number": 78,
        "verse_number": 6,
        "content": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 7,
        "content": "وَٱلۡجِبَالَ أَوۡتَادٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 8,
        "content": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 9,
        "content": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 10,
        "content": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 11,
        "content": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 12,
        "content": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 13,
        "content": "وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 14,
        "content": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 15,
        "content": "لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 16,
        "content": "وَجَنَّـٰتٍ أَلۡفَافًا"
    },
    {
        "surah_number": 78,
        "verse_number": 17,
        "content": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 18,
        "content": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 19,
        "content": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 20,
        "content": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا"
    },
    {
        "surah_number": 78,
        "verse_number": 21,
        "content": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 22,
        "content": "لِّلطَّـٰغِينَ مَـَٔابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 23,
        "content": "لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 24,
        "content": "لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا"
    },
    {
        "surah_number": 78,
        "verse_number": 25,
        "content": "إِلَّا حَمِيمٗا وَغَسَّاقٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 26,
        "content": "جَزَآءٗ وِفَاقًا"
    },
    {
        "surah_number": 78,
        "verse_number": 27,
        "content": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 28,
        "content": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 29,
        "content": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 30,
        "content": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا"
    },
    {
        "surah_number": 78,
        "verse_number": 31,
        "content": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا"
    },
    {
        "surah_number": 78,
        "verse_number": 32,
        "content": "حَدَآئِقَ وَأَعۡنَٰبٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 33,
        "content": "وَكَوَاعِبَ أَتۡرَابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 34,
        "content": "وَكَأۡسٗا دِهَاقٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 35,
        "content": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 36,
        "content": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 37,
        "content": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 38,
        "content": "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا"
    },
    {
        "surah_number": 78,
        "verse_number": 39,
        "content": "ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"
    },
    {
        "surah_number": 78,
        "verse_number": 40,
        "content": "إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا"
    }
]