[
    {
        "surah_number": 89,
        "verse_number": 1,
        "content": "وَٱلۡفَجۡرِ"
    },
    {
        "surah_number": 89,
        "verse_number": 2,
        "content": "وَلَيَالٍ عَشۡرٖ"
    },
    {
        "surah_number": 89,
        "verse_number": 3,
        "content": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ"
    },
    {
        "surah_number": 89,
        "verse_number": 4,
        "content": "وَٱلَّيۡلِ إِذَا يَسۡرِ"
    },
    {
        "surah_number": 89,
        "verse_number": 5,
        "content": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ"
    },
    {
        "surah_number": 89,
        "verse_number": 6,
        "content": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ"
    },
    {
        "surah_number": 89,
        "verse_number": 7,
        "content": "إِرَمَ ذَاتِ ٱلۡعِمَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 8,
        "content": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ"
    },
    {
        "surah_number": 89,
        "verse_number": 9,
        "content": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 10,
        "content": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 11,
        "content": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ"
    },
    {
        "surah_number": 89,
        "verse_number": 12,
        "content": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ"
    },
    {
        "surah_number": 89,
        "verse_number": 13,
        "content": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ"
    },
    {
        "surah_number": 89,
        "verse_number": 14,
        "content": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ"
    },
    {
        "surah_number": 89,
        "verse_number": 15,
        "content": "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ"
    },
    {
        "surah_number": 89,
        "verse_number": 16,
        "content": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ"
    },
    {
        "surah_number": 89,
        "verse_number": 17,
        "content": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ"
    },
    {
        "surah_number": 89,
        "verse_number": 18,
        "content": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"
    },
    {
        "surah_number": 89,
        "verse_number": 19,
        "content": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا"
    },
    {
        "surah_number": 89,
        "verse_number": 20,
        "content": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا"
    },
    {
        "surah_number": 89,
        "verse_number": 21,
        "content": "كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا"
    },
    {
        "surah_number": 89,
        "verse_number": 22,
        "content": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا"
    },
    {
        "surah_number": 89,
        "verse_number": 23,
        "content": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ"
    },
    {
        "surah_number": 89,
        "verse_number": 24,
        "content": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي"
    },
    {
        "surah_number": 89,
        "verse_number": 25,
        "content": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"
    },
    {
        "surah_number": 89,
        "verse_number": 26,
        "content": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ"
    },
    {
        "surah_number": 89,
        "verse_number": 27,
        "content": "يَـٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ"
    },
    {
        "surah_number": 89,
        "verse_number": 28,
        "content": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ"
    },
    {
        "surah_number": 89,
        "verse_number": 29,
        "content": "فَٱدۡخُلِي فِي عِبَٰدِي"
    },
    {
        "surah_number": 89,
        "verse_number": 30,
        "content": "وَٱدۡخُلِي جَنَّتِي"
    }
]