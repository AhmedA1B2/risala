[
    {
        "surah_number": 26,
        "verse_number": 1,
        "content": "طسٓمٓ"
    },
    {
        "surah_number": 26,
        "verse_number": 2,
        "content": "تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 3,
        "content": "لَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ أَلَّا يَكُونُواْ مُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 4,
        "content": "إِن نَّشَأۡ نُنَزِّلۡ عَلَيۡهِم مِّنَ ٱلسَّمَآءِ ءَايَةٗ فَظَلَّتۡ أَعۡنَٰقُهُمۡ لَهَا خَٰضِعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 5,
        "content": "وَمَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّنَ ٱلرَّحۡمَٰنِ مُحۡدَثٍ إِلَّا كَانُواْ عَنۡهُ مُعۡرِضِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 6,
        "content": "فَقَدۡ كَذَّبُواْ فَسَيَأۡتِيهِمۡ أَنۢبَـٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 7,
        "content": "أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ"
    },
    {
        "surah_number": 26,
        "verse_number": 8,
        "content": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 9,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 10,
        "content": "وَإِذۡ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئۡتِ ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 11,
        "content": "قَوۡمَ فِرۡعَوۡنَۚ أَلَا يَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 12,
        "content": "قَالَ رَبِّ إِنِّيٓ أَخَافُ أَن يُكَذِّبُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 13,
        "content": "وَيَضِيقُ صَدۡرِي وَلَا يَنطَلِقُ لِسَانِي فَأَرۡسِلۡ إِلَىٰ هَٰرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 14,
        "content": "وَلَهُمۡ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَن يَقۡتُلُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 15,
        "content": "قَالَ كَلَّاۖ فَٱذۡهَبَا بِـَٔايَٰتِنَآۖ إِنَّا مَعَكُم مُّسۡتَمِعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 16,
        "content": "فَأۡتِيَا فِرۡعَوۡنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 17,
        "content": "أَنۡ أَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَـٰٓءِيلَ"
    },
    {
        "surah_number": 26,
        "verse_number": 18,
        "content": "قَالَ أَلَمۡ نُرَبِّكَ فِينَا وَلِيدٗا وَلَبِثۡتَ فِينَا مِنۡ عُمُرِكَ سِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 19,
        "content": "وَفَعَلۡتَ فَعۡلَتَكَ ٱلَّتِي فَعَلۡتَ وَأَنتَ مِنَ ٱلۡكَٰفِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 20,
        "content": "قَالَ فَعَلۡتُهَآ إِذٗا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 21,
        "content": "فَفَرَرۡتُ مِنكُمۡ لَمَّا خِفۡتُكُمۡ فَوَهَبَ لِي رَبِّي حُكۡمٗا وَجَعَلَنِي مِنَ ٱلۡمُرۡسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 22,
        "content": "وَتِلۡكَ نِعۡمَةٞ تَمُنُّهَا عَلَيَّ أَنۡ عَبَّدتَّ بَنِيٓ إِسۡرَـٰٓءِيلَ"
    },
    {
        "surah_number": 26,
        "verse_number": 23,
        "content": "قَالَ فِرۡعَوۡنُ وَمَا رَبُّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 24,
        "content": "قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 25,
        "content": "قَالَ لِمَنۡ حَوۡلَهُۥٓ أَلَا تَسۡتَمِعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 26,
        "content": "قَالَ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 27,
        "content": "قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِيٓ أُرۡسِلَ إِلَيۡكُمۡ لَمَجۡنُونٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 28,
        "content": "قَالَ رَبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُمۡ تَعۡقِلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 29,
        "content": "قَالَ لَئِنِ ٱتَّخَذۡتَ إِلَٰهًا غَيۡرِي لَأَجۡعَلَنَّكَ مِنَ ٱلۡمَسۡجُونِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 30,
        "content": "قَالَ أَوَلَوۡ جِئۡتُكَ بِشَيۡءٖ مُّبِينٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 31,
        "content": "قَالَ فَأۡتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 32,
        "content": "فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعۡبَانٞ مُّبِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 33,
        "content": "وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيۡضَآءُ لِلنَّـٰظِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 34,
        "content": "قَالَ لِلۡمَلَإِ حَوۡلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 35,
        "content": "يُرِيدُ أَن يُخۡرِجَكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِۦ فَمَاذَا تَأۡمُرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 36,
        "content": "قَالُوٓاْ أَرۡجِهۡ وَأَخَاهُ وَٱبۡعَثۡ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 37,
        "content": "يَأۡتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 38,
        "content": "فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 39,
        "content": "وَقِيلَ لِلنَّاسِ هَلۡ أَنتُم مُّجۡتَمِعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 40,
        "content": "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُواْ هُمُ ٱلۡغَٰلِبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 41,
        "content": "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُواْ لِفِرۡعَوۡنَ أَئِنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَٰلِبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 42,
        "content": "قَالَ نَعَمۡ وَإِنَّكُمۡ إِذٗا لَّمِنَ ٱلۡمُقَرَّبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 43,
        "content": "قَالَ لَهُم مُّوسَىٰٓ أَلۡقُواْ مَآ أَنتُم مُّلۡقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 44,
        "content": "فَأَلۡقَوۡاْ حِبَالَهُمۡ وَعِصِيَّهُمۡ وَقَالُواْ بِعِزَّةِ فِرۡعَوۡنَ إِنَّا لَنَحۡنُ ٱلۡغَٰلِبُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 45,
        "content": "فَأَلۡقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِيَ تَلۡقَفُ مَا يَأۡفِكُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 46,
        "content": "فَأُلۡقِيَ ٱلسَّحَرَةُ سَٰجِدِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 47,
        "content": "قَالُوٓاْ ءَامَنَّا بِرَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 48,
        "content": "رَبِّ مُوسَىٰ وَهَٰرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 49,
        "content": "قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَ فَلَسَوۡفَ تَعۡلَمُونَۚ لَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ أَجۡمَعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 50,
        "content": "قَالُواْ لَا ضَيۡرَۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 51,
        "content": "إِنَّا نَطۡمَعُ أَن يَغۡفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَآ أَن كُنَّآ أَوَّلَ ٱلۡمُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 52,
        "content": "۞وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَسۡرِ بِعِبَادِيٓ إِنَّكُم مُّتَّبَعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 53,
        "content": "فَأَرۡسَلَ فِرۡعَوۡنُ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 54,
        "content": "إِنَّ هَـٰٓؤُلَآءِ لَشِرۡذِمَةٞ قَلِيلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 55,
        "content": "وَإِنَّهُمۡ لَنَا لَغَآئِظُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 56,
        "content": "وَإِنَّا لَجَمِيعٌ حَٰذِرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 57,
        "content": "فَأَخۡرَجۡنَٰهُم مِّن جَنَّـٰتٖ وَعُيُونٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 58,
        "content": "وَكُنُوزٖ وَمَقَامٖ كَرِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 59,
        "content": "كَذَٰلِكَۖ وَأَوۡرَثۡنَٰهَا بَنِيٓ إِسۡرَـٰٓءِيلَ"
    },
    {
        "surah_number": 26,
        "verse_number": 60,
        "content": "فَأَتۡبَعُوهُم مُّشۡرِقِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 61,
        "content": "فَلَمَّا تَرَـٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 62,
        "content": "قَالَ كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 63,
        "content": "فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقٖ كَٱلطَّوۡدِ ٱلۡعَظِيمِ"
    },
    {
        "surah_number": 26,
        "verse_number": 64,
        "content": "وَأَزۡلَفۡنَا ثَمَّ ٱلۡأٓخَرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 65,
        "content": "وَأَنجَيۡنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجۡمَعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 66,
        "content": "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 67,
        "content": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 68,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 69,
        "content": "وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ إِبۡرَٰهِيمَ"
    },
    {
        "surah_number": 26,
        "verse_number": 70,
        "content": "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا تَعۡبُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 71,
        "content": "قَالُواْ نَعۡبُدُ أَصۡنَامٗا فَنَظَلُّ لَهَا عَٰكِفِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 72,
        "content": "قَالَ هَلۡ يَسۡمَعُونَكُمۡ إِذۡ تَدۡعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 73,
        "content": "أَوۡ يَنفَعُونَكُمۡ أَوۡ يَضُرُّونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 74,
        "content": "قَالُواْ بَلۡ وَجَدۡنَآ ءَابَآءَنَا كَذَٰلِكَ يَفۡعَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 75,
        "content": "قَالَ أَفَرَءَيۡتُم مَّا كُنتُمۡ تَعۡبُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 76,
        "content": "أَنتُمۡ وَءَابَآؤُكُمُ ٱلۡأَقۡدَمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 77,
        "content": "فَإِنَّهُمۡ عَدُوّٞ لِّيٓ إِلَّا رَبَّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 78,
        "content": "ٱلَّذِي خَلَقَنِي فَهُوَ يَهۡدِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 79,
        "content": "وَٱلَّذِي هُوَ يُطۡعِمُنِي وَيَسۡقِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 80,
        "content": "وَإِذَا مَرِضۡتُ فَهُوَ يَشۡفِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 81,
        "content": "وَٱلَّذِي يُمِيتُنِي ثُمَّ يُحۡيِينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 82,
        "content": "وَٱلَّذِيٓ أَطۡمَعُ أَن يَغۡفِرَ لِي خَطِيٓـَٔتِي يَوۡمَ ٱلدِّينِ"
    },
    {
        "surah_number": 26,
        "verse_number": 83,
        "content": "رَبِّ هَبۡ لِي حُكۡمٗا وَأَلۡحِقۡنِي بِٱلصَّـٰلِحِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 84,
        "content": "وَٱجۡعَل لِّي لِسَانَ صِدۡقٖ فِي ٱلۡأٓخِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 85,
        "content": "وَٱجۡعَلۡنِي مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ"
    },
    {
        "surah_number": 26,
        "verse_number": 86,
        "content": "وَٱغۡفِرۡ لِأَبِيٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 87,
        "content": "وَلَا تُخۡزِنِي يَوۡمَ يُبۡعَثُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 88,
        "content": "يَوۡمَ لَا يَنفَعُ مَالٞ وَلَا بَنُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 89,
        "content": "إِلَّا مَنۡ أَتَى ٱللَّهَ بِقَلۡبٖ سَلِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 90,
        "content": "وَأُزۡلِفَتِ ٱلۡجَنَّةُ لِلۡمُتَّقِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 91,
        "content": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِلۡغَاوِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 92,
        "content": "وَقِيلَ لَهُمۡ أَيۡنَ مَا كُنتُمۡ تَعۡبُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 93,
        "content": "مِن دُونِ ٱللَّهِ هَلۡ يَنصُرُونَكُمۡ أَوۡ يَنتَصِرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 94,
        "content": "فَكُبۡكِبُواْ فِيهَا هُمۡ وَٱلۡغَاوُۥنَ"
    },
    {
        "surah_number": 26,
        "verse_number": 95,
        "content": "وَجُنُودُ إِبۡلِيسَ أَجۡمَعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 96,
        "content": "قَالُواْ وَهُمۡ فِيهَا يَخۡتَصِمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 97,
        "content": "تَٱللَّهِ إِن كُنَّا لَفِي ضَلَٰلٖ مُّبِينٍ"
    },
    {
        "surah_number": 26,
        "verse_number": 98,
        "content": "إِذۡ نُسَوِّيكُم بِرَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 99,
        "content": "وَمَآ أَضَلَّنَآ إِلَّا ٱلۡمُجۡرِمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 100,
        "content": "فَمَا لَنَا مِن شَٰفِعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 101,
        "content": "وَلَا صَدِيقٍ حَمِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 102,
        "content": "فَلَوۡ أَنَّ لَنَا كَرَّةٗ فَنَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 103,
        "content": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 104,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 105,
        "content": "كَذَّبَتۡ قَوۡمُ نُوحٍ ٱلۡمُرۡسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 106,
        "content": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ نُوحٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 107,
        "content": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 108,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 109,
        "content": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 110,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 111,
        "content": "۞قَالُوٓاْ أَنُؤۡمِنُ لَكَ وَٱتَّبَعَكَ ٱلۡأَرۡذَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 112,
        "content": "قَالَ وَمَا عِلۡمِي بِمَا كَانُواْ يَعۡمَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 113,
        "content": "إِنۡ حِسَابُهُمۡ إِلَّا عَلَىٰ رَبِّيۖ لَوۡ تَشۡعُرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 114,
        "content": "وَمَآ أَنَا۠ بِطَارِدِ ٱلۡمُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 115,
        "content": "إِنۡ أَنَا۠ إِلَّا نَذِيرٞ مُّبِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 116,
        "content": "قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلۡمَرۡجُومِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 117,
        "content": "قَالَ رَبِّ إِنَّ قَوۡمِي كَذَّبُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 118,
        "content": "فَٱفۡتَحۡ بَيۡنِي وَبَيۡنَهُمۡ فَتۡحٗا وَنَجِّنِي وَمَن مَّعِيَ مِنَ ٱلۡمُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 119,
        "content": "فَأَنجَيۡنَٰهُ وَمَن مَّعَهُۥ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 120,
        "content": "ثُمَّ أَغۡرَقۡنَا بَعۡدُ ٱلۡبَاقِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 121,
        "content": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 122,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 123,
        "content": "كَذَّبَتۡ عَادٌ ٱلۡمُرۡسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 124,
        "content": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ هُودٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 125,
        "content": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 126,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 127,
        "content": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 128,
        "content": "أَتَبۡنُونَ بِكُلِّ رِيعٍ ءَايَةٗ تَعۡبَثُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 129,
        "content": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمۡ تَخۡلُدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 130,
        "content": "وَإِذَا بَطَشۡتُم بَطَشۡتُمۡ جَبَّارِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 131,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 132,
        "content": "وَٱتَّقُواْ ٱلَّذِيٓ أَمَدَّكُم بِمَا تَعۡلَمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 133,
        "content": "أَمَدَّكُم بِأَنۡعَٰمٖ وَبَنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 134,
        "content": "وَجَنَّـٰتٖ وَعُيُونٍ"
    },
    {
        "surah_number": 26,
        "verse_number": 135,
        "content": "إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 136,
        "content": "قَالُواْ سَوَآءٌ عَلَيۡنَآ أَوَعَظۡتَ أَمۡ لَمۡ تَكُن مِّنَ ٱلۡوَٰعِظِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 137,
        "content": "إِنۡ هَٰذَآ إِلَّا خُلُقُ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 138,
        "content": "وَمَا نَحۡنُ بِمُعَذَّبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 139,
        "content": "فَكَذَّبُوهُ فَأَهۡلَكۡنَٰهُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 140,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 141,
        "content": "كَذَّبَتۡ ثَمُودُ ٱلۡمُرۡسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 142,
        "content": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ صَٰلِحٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 143,
        "content": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 144,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 145,
        "content": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 146,
        "content": "أَتُتۡرَكُونَ فِي مَا هَٰهُنَآ ءَامِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 147,
        "content": "فِي جَنَّـٰتٖ وَعُيُونٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 148,
        "content": "وَزُرُوعٖ وَنَخۡلٖ طَلۡعُهَا هَضِيمٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 149,
        "content": "وَتَنۡحِتُونَ مِنَ ٱلۡجِبَالِ بُيُوتٗا فَٰرِهِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 150,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 151,
        "content": "وَلَا تُطِيعُوٓاْ أَمۡرَ ٱلۡمُسۡرِفِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 152,
        "content": "ٱلَّذِينَ يُفۡسِدُونَ فِي ٱلۡأَرۡضِ وَلَا يُصۡلِحُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 153,
        "content": "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 154,
        "content": "مَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا فَأۡتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 155,
        "content": "قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرۡبٞ وَلَكُمۡ شِرۡبُ يَوۡمٖ مَّعۡلُومٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 156,
        "content": "وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأۡخُذَكُمۡ عَذَابُ يَوۡمٍ عَظِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 157,
        "content": "فَعَقَرُوهَا فَأَصۡبَحُواْ نَٰدِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 158,
        "content": "فَأَخَذَهُمُ ٱلۡعَذَابُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 159,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 160,
        "content": "كَذَّبَتۡ قَوۡمُ لُوطٍ ٱلۡمُرۡسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 161,
        "content": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ لُوطٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 162,
        "content": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 163,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 164,
        "content": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 165,
        "content": "أَتَأۡتُونَ ٱلذُّكۡرَانَ مِنَ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 166,
        "content": "وَتَذَرُونَ مَا خَلَقَ لَكُمۡ رَبُّكُم مِّنۡ أَزۡوَٰجِكُمۚ بَلۡ أَنتُمۡ قَوۡمٌ عَادُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 167,
        "content": "قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلۡمُخۡرَجِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 168,
        "content": "قَالَ إِنِّي لِعَمَلِكُم مِّنَ ٱلۡقَالِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 169,
        "content": "رَبِّ نَجِّنِي وَأَهۡلِي مِمَّا يَعۡمَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 170,
        "content": "فَنَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 171,
        "content": "إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 172,
        "content": "ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 173,
        "content": "وَأَمۡطَرۡنَا عَلَيۡهِم مَّطَرٗاۖ فَسَآءَ مَطَرُ ٱلۡمُنذَرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 174,
        "content": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 175,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 176,
        "content": "كَذَّبَ أَصۡحَٰبُ لۡـَٔيۡكَةِ ٱلۡمُرۡسَلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 177,
        "content": "إِذۡ قَالَ لَهُمۡ شُعَيۡبٌ أَلَا تَتَّقُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 178,
        "content": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ"
    },
    {
        "surah_number": 26,
        "verse_number": 179,
        "content": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
        "surah_number": 26,
        "verse_number": 180,
        "content": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 181,
        "content": "۞أَوۡفُواْ ٱلۡكَيۡلَ وَلَا تَكُونُواْ مِنَ ٱلۡمُخۡسِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 182,
        "content": "وَزِنُواْ بِٱلۡقِسۡطَاسِ ٱلۡمُسۡتَقِيمِ"
    },
    {
        "surah_number": 26,
        "verse_number": 183,
        "content": "وَلَا تَبۡخَسُواْ ٱلنَّاسَ أَشۡيَآءَهُمۡ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 184,
        "content": "وَٱتَّقُواْ ٱلَّذِي خَلَقَكُمۡ وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 185,
        "content": "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 186,
        "content": "وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلۡكَٰذِبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 187,
        "content": "فَأَسۡقِطۡ عَلَيۡنَا كِسَفٗا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 188,
        "content": "قَالَ رَبِّيٓ أَعۡلَمُ بِمَا تَعۡمَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 189,
        "content": "فَكَذَّبُوهُ فَأَخَذَهُمۡ عَذَابُ يَوۡمِ ٱلظُّلَّةِۚ إِنَّهُۥ كَانَ عَذَابَ يَوۡمٍ عَظِيمٍ"
    },
    {
        "surah_number": 26,
        "verse_number": 190,
        "content": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 191,
        "content": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 192,
        "content": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 193,
        "content": "نَزَلَ بِهِ ٱلرُّوحُ ٱلۡأَمِينُ"
    },
    {
        "surah_number": 26,
        "verse_number": 194,
        "content": "عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 195,
        "content": "بِلِسَانٍ عَرَبِيّٖ مُّبِينٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 196,
        "content": "وَإِنَّهُۥ لَفِي زُبُرِ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 197,
        "content": "أَوَلَمۡ يَكُن لَّهُمۡ ءَايَةً أَن يَعۡلَمَهُۥ عُلَمَـٰٓؤُاْ بَنِيٓ إِسۡرَـٰٓءِيلَ"
    },
    {
        "surah_number": 26,
        "verse_number": 198,
        "content": "وَلَوۡ نَزَّلۡنَٰهُ عَلَىٰ بَعۡضِ ٱلۡأَعۡجَمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 199,
        "content": "فَقَرَأَهُۥ عَلَيۡهِم مَّا كَانُواْ بِهِۦ مُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 200,
        "content": "كَذَٰلِكَ سَلَكۡنَٰهُ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 201,
        "content": "لَا يُؤۡمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ"
    },
    {
        "surah_number": 26,
        "verse_number": 202,
        "content": "فَيَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 203,
        "content": "فَيَقُولُواْ هَلۡ نَحۡنُ مُنظَرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 204,
        "content": "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 205,
        "content": "أَفَرَءَيۡتَ إِن مَّتَّعۡنَٰهُمۡ سِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 206,
        "content": "ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 207,
        "content": "مَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يُمَتَّعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 208,
        "content": "وَمَآ أَهۡلَكۡنَا مِن قَرۡيَةٍ إِلَّا لَهَا مُنذِرُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 209,
        "content": "ذِكۡرَىٰ وَمَا كُنَّا ظَٰلِمِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 210,
        "content": "وَمَا تَنَزَّلَتۡ بِهِ ٱلشَّيَٰطِينُ"
    },
    {
        "surah_number": 26,
        "verse_number": 211,
        "content": "وَمَا يَنۢبَغِي لَهُمۡ وَمَا يَسۡتَطِيعُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 212,
        "content": "إِنَّهُمۡ عَنِ ٱلسَّمۡعِ لَمَعۡزُولُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 213,
        "content": "فَلَا تَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلۡمُعَذَّبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 214,
        "content": "وَأَنذِرۡ عَشِيرَتَكَ ٱلۡأَقۡرَبِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 215,
        "content": "وَٱخۡفِضۡ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلۡمُؤۡمِنِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 216,
        "content": "فَإِنۡ عَصَوۡكَ فَقُلۡ إِنِّي بَرِيٓءٞ مِّمَّا تَعۡمَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 217,
        "content": "وَتَوَكَّلۡ عَلَى ٱلۡعَزِيزِ ٱلرَّحِيمِ"
    },
    {
        "surah_number": 26,
        "verse_number": 218,
        "content": "ٱلَّذِي يَرَىٰكَ حِينَ تَقُومُ"
    },
    {
        "surah_number": 26,
        "verse_number": 219,
        "content": "وَتَقَلُّبَكَ فِي ٱلسَّـٰجِدِينَ"
    },
    {
        "surah_number": 26,
        "verse_number": 220,
        "content": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ"
    },
    {
        "surah_number": 26,
        "verse_number": 221,
        "content": "هَلۡ أُنَبِّئُكُمۡ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَٰطِينُ"
    },
    {
        "surah_number": 26,
        "verse_number": 222,
        "content": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٖ"
    },
    {
        "surah_number": 26,
        "verse_number": 223,
        "content": "يُلۡقُونَ ٱلسَّمۡعَ وَأَكۡثَرُهُمۡ كَٰذِبُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 224,
        "content": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلۡغَاوُۥنَ"
    },
    {
        "surah_number": 26,
        "verse_number": 225,
        "content": "أَلَمۡ تَرَ أَنَّهُمۡ فِي كُلِّ وَادٖ يَهِيمُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 226,
        "content": "وَأَنَّهُمۡ يَقُولُونَ مَا لَا يَفۡعَلُونَ"
    },
    {
        "surah_number": 26,
        "verse_number": 227,
        "content": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَذَكَرُواْ ٱللَّهَ كَثِيرٗا وَٱنتَصَرُواْ مِنۢ بَعۡدِ مَا ظُلِمُواْۗ وَسَيَعۡلَمُ ٱلَّذِينَ ظَلَمُوٓاْ أَيَّ مُنقَلَبٖ يَنقَلِبُونَ"
    }
]