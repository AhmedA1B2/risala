[
    {
        "surah_number": 93,
        "verse_number": 1,
        "content": "وَٱلضُّحَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 2,
        "content": "وَٱلَّيۡلِ إِذَا سَجَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 3,
        "content": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 4,
        "content": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 5,
        "content": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ"
    },
    {
        "surah_number": 93,
        "verse_number": 6,
        "content": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 7,
        "content": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 8,
        "content": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ"
    },
    {
        "surah_number": 93,
        "verse_number": 9,
        "content": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ"
    },
    {
        "surah_number": 93,
        "verse_number": 10,
        "content": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ"
    },
    {
        "surah_number": 93,
        "verse_number": 11,
        "content": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"
    }
]