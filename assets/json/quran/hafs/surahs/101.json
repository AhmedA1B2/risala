        "surah_number": 101,
        "verse_number": 2,
        "content": "مَا ٱلۡقَارِعَةُ"
    },
    {
        "surah_number": 101,
        "verse_number": 3,
        "content": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"
    },
    {
        "surah_number": 101,
        "verse_number": 4,
        "content": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"
    },
    {
        "surah_number": 101,
        "verse_number": 5,
        "content": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"
    },
    {
        "surah_number": 101,
        "verse_number": 6,
        "content": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"
    },
    {
        "surah_number": 101,
        "verse_number": 7,
        "content": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ"
    },
    {
        "surah_number": 101,
        "verse_number": 8,
        "content": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"
    },
    {
        "surah_number": 101,
        "verse_number": 9,
        "content": "فَأُمُّهُۥ هَاوِيَةٞ"
    },
    {
        "surah_number": 101,
        "verse_number": 10,
        "content": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ"
    },
    {
        "surah_number": 101,
        "verse_number": 11,
        "content": "نَارٌ حَامِيَةُۢ"
    }
]