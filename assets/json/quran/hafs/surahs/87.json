[
    {
        "surah_number": 87,
        "verse_number": 1,
        "content": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى"
    },
    {
        "surah_number": 87,
        "verse_number": 2,
        "content": "ٱلَّذِي خَلَقَ فَسَوَّىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 3,
        "content": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 4,
        "content": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 5,
        "content": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 6,
        "content": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ"
    },
    {
        "surah_number": 87,
        "verse_number": 7,
        "content": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 8,
        "content": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 9,
        "content": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 10,
        "content": "سَيَذَّكَّرُ مَن يَخۡشَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 11,
        "content": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى"
    },
    {
        "surah_number": 87,
        "verse_number": 12,
        "content": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 13,
        "content": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 14,
        "content": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 15,
        "content": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 16,
        "content": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"
    },
    {
        "surah_number": 87,
        "verse_number": 17,
        "content": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ"
    },
    {
        "surah_number": 87,
        "verse_number": 18,
        "content": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ"
    },
    {
        "surah_number": 87,
        "verse_number": 19,
        "content": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ"
    }
]