[
    {
        "surah_number": 86,
        "verse_number": 1,
        "content": "وَٱلسَّمَآءِ وَٱلطَّارِقِ"
    },
    {
        "surah_number": 86,
        "verse_number": 2,
        "content": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ"
    },
    {
        "surah_number": 86,
        "verse_number": 3,
        "content": "ٱلنَّجۡمُ ٱلثَّاقِبُ"
    },
    {
        "surah_number": 86,
        "verse_number": 4,
        "content": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ"
    },
    {
        "surah_number": 86,
        "verse_number": 5,
        "content": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ"
    },
    {
        "surah_number": 86,
        "verse_number": 6,
        "content": "خُلِقَ مِن مَّآءٖ دَافِقٖ"
    },
    {
        "surah_number": 86,
        "verse_number": 7,
        "content": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ"
    },
    {
        "surah_number": 86,
        "verse_number": 8,
        "content": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ"
    },
    {
        "surah_number": 86,
        "verse_number": 9,
        "content": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ"
    },
    {
        "surah_number": 86,
        "verse_number": 10,
        "content": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ"
    },
    {
        "surah_number": 86,
        "verse_number": 11,
        "content": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ"
    },
    {
        "surah_number": 86,
        "verse_number": 12,
        "content": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ"
    },
    {
        "surah_number": 86,
        "verse_number": 13,
        "content": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ"
    },
    {
        "surah_number": 86,
        "verse_number": 14,
        "content": "وَمَا هُوَ بِٱلۡهَزۡلِ"
    },
    {
        "surah_number": 86,
        "verse_number": 15,
        "content": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا"
    },
    {
        "surah_number": 86,
        "verse_number": 16,
        "content": "وَأَكِيدُ كَيۡدٗا"
    },
    {
        "surah_number": 86,
        "verse_number": 17,
        "content": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا"
    }
]