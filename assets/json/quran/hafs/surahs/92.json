        "verse_number": 6,
        "content": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 7,
        "content": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 8,
        "content": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 9,
        "content": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ"
    },
    {
        "surah_number": 92,
        "verse_number": 10,
        "content": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"
    },
    {
