[
    {
        "surah_number": 84,
        "verse_number": 1,
        "content": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ"
    },
    {
        "surah_number": 84,
        "verse_number": 2,
        "content": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"
    },
    {
        "surah_number": 84,
        "verse_number": 3,
        "content": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ"
    },
    {
        "surah_number": 84,
        "verse_number": 4,
        "content": "وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"
    },
    {
        "surah_number": 84,
        "verse_number": 5,
        "content": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"
    },
    {
        "surah_number": 84,
        "verse_number": 6,
        "content": "يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ"
    },
    {
        "surah_number": 84,
        "verse_number": 7,
        "content": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"
    },
    {
        "surah_number": 84,
        "verse_number": 8,
        "content": "فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا"
    },
    {
        "surah_number": 84,
        "verse_number": 9,
        "content": "وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا"
    },
    {
        "surah_number": 84,
        "verse_number": 10,
        "content": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ"
    },
    {
        "surah_number": 84,
        "verse_number": 11,
        "content": "فَسَوۡفَ يَدۡعُواْ ثُبُورٗا"
    },
    {
        "surah_number": 84,
        "verse_number": 12,
        "content": "وَيَصۡلَىٰ سَعِيرًا"
    },
    {
        "surah_number": 84,
        "verse_number": 13,
        "content": "إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"
    },
    {
        "surah_number": 84,
        "verse_number": 14,
        "content": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"
    },
    {
        "surah_number": 84,
        "verse_number": 15,
        "content": "بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا"
    },
    {
        "surah_number": 84,
        "verse_number": 16,
        "content": "فَلَآ أُقۡسِمُ بِٱلشَّفَقِ"
    },
    {
        "surah_number": 84,
        "verse_number": 17,
        "content": "وَٱلَّيۡلِ وَمَا وَسَقَ"
    },
    {
        "surah_number": 84,
        "verse_number": 18,
        "content": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ"
    },
    {
        "surah_number": 84,
        "verse_number": 19,
        "content": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ"
    },
    {
        "surah_number": 84,
        "verse_number": 20,
        "content": "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"
    },
    {
        "surah_number": 84,
        "verse_number": 21,
        "content": "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩"
    },
    {
        "surah_number": 84,
        "verse_number": 22,
        "content": "بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ"
    },
    {
        "surah_number": 84,
        "verse_number": 23,
        "content": "وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"
    },
    {
        "surah_number": 84,
        "verse_number": 24,
        "content": "فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"
    },
    {
        "surah_number": 84,
        "verse_number": 25,
        "content": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ"
    }
]