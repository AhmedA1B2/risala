[
    {
        "surah_number": 56,
        "verse_number": 1,
        "content": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ"
    },
    {
        "surah_number": 56,
        "verse_number": 2,
        "content": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ"
    },
    {
        "surah_number": 56,
        "verse_number": 3,
        "content": "خَافِضَةٞ رَّافِعَةٌ"
    },
    {
        "surah_number": 56,
        "verse_number": 4,
        "content": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا"
    },
    {
        "surah_number": 56,
        "verse_number": 5,
        "content": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا"
    },
    {
        "surah_number": 56,
        "verse_number": 6,
        "content": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا"
    },
    {
        "surah_number": 56,
        "verse_number": 7,
        "content": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 8,
        "content": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"
    },
    {
        "surah_number": 56,
        "verse_number": 9,
        "content": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"
    },
    {
        "surah_number": 56,
        "verse_number": 10,
        "content": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 11,
        "content": "أُوْلَـٰٓئِكَ ٱلۡمُقَرَّبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 12,
        "content": "فِي جَنَّـٰتِ ٱلنَّعِيمِ"
    },
    {
        "surah_number": 56,
        "verse_number": 13,
        "content": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 14,
        "content": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 15,
        "content": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 16,
        "content": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 17,
        "content": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 18,
        "content": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 19,
        "content": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 20,
        "content": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 21,
        "content": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 22,
        "content": "وَحُورٌ عِينٞ"
    },
    {
        "surah_number": 56,
        "verse_number": 23,
        "content": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ"
    },
    {
        "surah_number": 56,
        "verse_number": 24,
        "content": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 25,
        "content": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا"
    },
    {
        "surah_number": 56,
        "verse_number": 26,
        "content": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا"
    },
    {
        "surah_number": 56,
        "verse_number": 27,
        "content": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 28,
        "content": "فِي سِدۡرٖ مَّخۡضُودٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 29,
        "content": "وَطَلۡحٖ مَّنضُودٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 30,
        "content": "وَظِلّٖ مَّمۡدُودٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 31,
        "content": "وَمَآءٖ مَّسۡكُوبٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 32,
        "content": "وَفَٰكِهَةٖ كَثِيرَةٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 33,
        "content": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 34,
        "content": "وَفُرُشٖ مَّرۡفُوعَةٍ"
    },
    {
        "surah_number": 56,
        "verse_number": 35,
        "content": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ"
    },
    {
        "surah_number": 56,
        "verse_number": 36,
        "content": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا"
    },
    {
        "surah_number": 56,
        "verse_number": 37,
        "content": "عُرُبًا أَتۡرَابٗا"
    },
    {
        "surah_number": 56,
        "verse_number": 38,
        "content": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 39,
        "content": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 40,
        "content": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 41,
        "content": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ"
    },
    {
        "surah_number": 56,
        "verse_number": 42,
        "content": "فِي سَمُومٖ وَحَمِيمٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 43,
        "content": "وَظِلّٖ مِّن يَحۡمُومٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 44,
        "content": "لَّا بَارِدٖ وَلَا كَرِيمٍ"
    },
    {
        "surah_number": 56,
        "verse_number": 45,
        "content": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 46,
        "content": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ"
    },
    {
        "surah_number": 56,
        "verse_number": 47,
        "content": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 48,
        "content": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 49,
        "content": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 50,
        "content": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 51,
        "content": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 52,
        "content": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 53,
        "content": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 54,
        "content": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ"
    },
    {
        "surah_number": 56,
        "verse_number": 55,
        "content": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ"
    },
    {
        "surah_number": 56,
        "verse_number": 56,
        "content": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 57,
        "content": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 58,
        "content": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 59,
        "content": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 60,
        "content": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 61,
        "content": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 62,
        "content": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 63,
        "content": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 64,
        "content": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 65,
        "content": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 66,
        "content": "إِنَّا لَمُغۡرَمُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 67,
        "content": "بَلۡ نَحۡنُ مَحۡرُومُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 68,
        "content": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 69,
        "content": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 70,
        "content": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 71,
        "content": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 72,
        "content": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 73,
        "content": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 74,
        "content": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"
    },
    {
        "surah_number": 56,
        "verse_number": 75,
        "content": "۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"
    },
    {
        "surah_number": 56,
        "verse_number": 76,
        "content": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ"
    },
    {
        "surah_number": 56,
        "verse_number": 77,
        "content": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ"
    },
    {
        "surah_number": 56,
        "verse_number": 78,
        "content": "فِي كِتَٰبٖ مَّكۡنُونٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 79,
        "content": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 80,
        "content": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 81,
        "content": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 82,
        "content": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 83,
        "content": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ"
    },
    {
        "surah_number": 56,
        "verse_number": 84,
        "content": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 85,
        "content": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ"
    },
    {
        "surah_number": 56,
        "verse_number": 86,
        "content": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 87,
        "content": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 88,
        "content": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 89,
        "content": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 90,
        "content": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 91,
        "content": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 92,
        "content": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ"
    },
    {
        "surah_number": 56,
        "verse_number": 93,
        "content": "فَنُزُلٞ مِّنۡ حَمِيمٖ"
    },
    {
        "surah_number": 56,
        "verse_number": 94,
        "content": "وَتَصۡلِيَةُ جَحِيمٍ"
    },
    {
        "surah_number": 56,
        "verse_number": 95,
        "content": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ"
    },
    {
        "surah_number": 56,
        "verse_number": 96,
        "content": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"
    }
]