[
    {
        "surah_number": 55,
        "verse_number": 1,
        "content": "ٱلرَّحۡمَٰنُ"
    },
    {
        "surah_number": 55,
        "verse_number": 2,
        "content": "عَلَّمَ ٱلۡقُرۡءَانَ"
    },
    {
        "surah_number": 55,
        "verse_number": 3,
        "content": "خَلَقَ ٱلۡإِنسَٰنَ"
    },
    {
        "surah_number": 55,
        "verse_number": 4,
        "content": "عَلَّمَهُ ٱلۡبَيَانَ"
    },
    {
        "surah_number": 55,
        "verse_number": 5,
        "content": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 6,
        "content": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 7,
        "content": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ"
    },
    {
        "surah_number": 55,
        "verse_number": 8,
        "content": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 9,
        "content": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ"
    },
    {
        "surah_number": 55,
        "verse_number": 10,
        "content": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 11,
        "content": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 12,
        "content": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ"
    },
    {
        "surah_number": 55,
        "verse_number": 13,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 14,
        "content": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ"
    },
    {
        "surah_number": 55,
        "verse_number": 15,
        "content": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 16,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 17,
        "content": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ"
    },
    {
        "surah_number": 55,
        "verse_number": 18,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 19,
        "content": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 20,
        "content": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 21,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 22,
        "content": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ"
    },
    {
        "surah_number": 55,
        "verse_number": 23,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 24,
        "content": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ"
    },
    {
        "surah_number": 55,
        "verse_number": 25,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 26,
        "content": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 27,
        "content": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 28,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 29,
        "content": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 30,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 31,
        "content": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 32,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 33,
        "content": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 34,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 35,
        "content": "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 36,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 37,
        "content": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 38,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 39,
        "content": "فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ"
    },
    {
        "surah_number": 55,
        "verse_number": 40,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 41,
        "content": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 42,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 43,
        "content": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ"
    },
    {
        "surah_number": 55,
        "verse_number": 44,
        "content": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 45,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 46,
        "content": "وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 47,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 48,
        "content": "ذَوَاتَآ أَفۡنَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 49,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 50,
        "content": "فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 51,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 52,
        "content": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 53,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 54,
        "content": "مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى ٱلۡجَنَّتَيۡنِ دَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 55,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 56,
        "content": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ"
    },
    {
        "surah_number": 55,
        "verse_number": 57,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 58,
        "content": "كَأَنَّهُنَّ ٱلۡيَاقُوتُ وَٱلۡمَرۡجَانُ"
    },
    {
        "surah_number": 55,
        "verse_number": 59,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 60,
        "content": "هَلۡ جَزَآءُ ٱلۡإِحۡسَٰنِ إِلَّا ٱلۡإِحۡسَٰنُ"
    },
    {
        "surah_number": 55,
        "verse_number": 61,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 62,
        "content": "وَمِن دُونِهِمَا جَنَّتَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 63,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 64,
        "content": "مُدۡهَآمَّتَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 65,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 66,
        "content": "فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 67,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 68,
        "content": "فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ"
    },
    {
        "surah_number": 55,
        "verse_number": 69,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 70,
        "content": "فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ"
    },
    {
        "surah_number": 55,
        "verse_number": 71,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 72,
        "content": "حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ"
    },
    {
        "surah_number": 55,
        "verse_number": 73,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 74,
        "content": "لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ"
    },
    {
        "surah_number": 55,
        "verse_number": 75,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 76,
        "content": "مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ"
    },
    {
        "surah_number": 55,
        "verse_number": 77,
        "content": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
        "surah_number": 55,
        "verse_number": 78,
        "content": "تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ"
    }
]